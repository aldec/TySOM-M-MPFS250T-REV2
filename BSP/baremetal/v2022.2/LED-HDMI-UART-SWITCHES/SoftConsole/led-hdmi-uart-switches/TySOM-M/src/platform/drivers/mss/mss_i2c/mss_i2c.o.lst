 693:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             /*
 694:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              * Clear the pending transaction. This condition will be true if the slave
 695:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              * has acquired the bus to carry out pending master transaction which
 696:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              * it had received during its slave transmission or reception mode.
 697:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              */
 698:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             if (this_i2c->is_transaction_pending)
 699:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             {
 700:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 this_i2c->is_transaction_pending = 0u;
