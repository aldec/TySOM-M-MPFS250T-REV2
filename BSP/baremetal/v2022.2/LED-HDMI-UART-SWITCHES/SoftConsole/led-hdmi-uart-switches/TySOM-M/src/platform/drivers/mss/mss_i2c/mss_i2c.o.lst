  27:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define WRITE_DIR    0u
  28:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define READ_DIR     1u
  29:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
  30:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** /* -- TRANSACTIONS TYPES -- */
  31:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define NO_TRANSACTION                      0u
  32:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define MASTER_WRITE_TRANSACTION            1u
  33:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define MASTER_READ_TRANSACTION             2u
  34:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define MASTER_RANDOM_READ_TRANSACTION      3u
  35:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define WRITE_SLAVE_TRANSACTION             4u
  36:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define READ_SLAVE_TRANSACTION              5u
  37:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
  38:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** /* -- SMBUS H/W STATES -- */
  39:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** /* -- MASTER STATES -- */
  40:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_BUS_ERROR        0x00u           /* Bus error during MST or selected slave modes */
  41:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_I2C_IDLE         0xF8u           /* No activity and no interrupt either... */
  42:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_START            0x08u           /* start condition sent */
  43:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_RESTART          0x10u           /* repeated start */
  44:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_SLAW_ACK         0x18u           /* SLA+W sent, ack received */
  45:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_SLAW_NACK        0x20u           /* SLA+W sent, nack received */
  46:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_TX_DATA_ACK      0x28u           /* Data sent, ACK'ed */
  47:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_TX_DATA_NACK     0x30u           /* Data sent, NACK'ed */
  48:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_LOST_ARB         0x38u           /* Master lost arbitration */
  49:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_SLAR_ACK         0x40u           /* SLA+R sent, ACK'ed */
  50:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_SLAR_NACK        0x48u           /* SLA+R sent, NACK'ed */
  51:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_RX_DATA_ACK      0x50u           /* Data received, ACK sent */
  52:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_RX_DATA_NACK     0x58u           /* Data received, NACK sent */
  53:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_RESET_ACTIVATED  0xD0u           /* Master reset is activated */
  54:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
  55:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** /* -- SLAVE STATES -- */
  56:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_SLAVE_SLAW       0x60u           /* SLA+W received */
  57:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_SLAVE_SLAR_ACK   0xA8u           /* SLA+R received, ACK returned */
  58:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_SLV_LA           0x68u           /* Slave lost arbitration */
  59:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_GCA              0x70u           /* GCA received */
  60:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_GCA_LA           0x78u           /* GCA lost arbitration */
  61:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_RDATA            0x80u           /* Data received */
  62:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_SLA_NACK         0x88u           /* Slave addressed, NACK returned */
  63:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_GCA_ACK          0x90u           /* Previously addresses with GCA, data ACKed */
  64:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_GCA_NACK         0x98u           /* GCA addressed, NACK returned */
  65:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_RSTOP            0xA0u           /* Stop received */
  66:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_SLARW_LA         0xB0u           /* Arbitration lost */
  67:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_RACK             0xB8u           /* Byte sent, ACK received */
  68:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_SLAVE_RNACK      0xC0u           /* Byte sent, NACK received */
  69:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_FINAL            0xC8u           /* Final byte sent, ACK received */
  70:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #define ST_SLV_RST          0xD8u           /* Slave reset state */
  71:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
  72:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** /*
  73:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****  * Maximum address offset length in slave write-read transactions.
  74:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****  * A maximum of two bytes will be interpreted as address offset within the slave
  75:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****  * tx buffer.
