 758:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 }
 759:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 else
 760:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 {
 761:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 762:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                     PLIC_DisableIRQ(this_i2c->irqn);
 763:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 764:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                     clear_irq = 0u;
 765:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 }
 766:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 this_i2c->master_status = MSS_I2C_SUCCESS;
 767:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             }
 768:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             break;
 769:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 770:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****         case ST_TX_DATA_NACK:
 771:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             /* data byte SENT, ACK to be received
 772:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              * In fact, this means we've received a NACK (This may not be
 773:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              * obvious, but if we've rec'd an ACK then we would be in state
 774:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              * 0x28!) hence, let's send a stop bit
 775:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              */
 776:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             this_i2c->hw_reg->CTRL |= STO_MASK;
 777:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             this_i2c->master_status = MSS_I2C_FAILED;
 778:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 779:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             /*
 780:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              * Set the transaction back to NO_TRANSACTION to allow user to do further
 781:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              * transaction
 782:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              */
 783:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             this_i2c->transaction = NO_TRANSACTION;
 784:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             enable_slave_if_required(this_i2c);
 785:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 786:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             break;
 787:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 788:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****         /********************* MASTER (or slave?) RECEIVER *************************/
 789:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 790:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****         /* STATUS codes 08H, 10H, 38H are all covered in MTX mode */
 791:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****         case ST_SLAR_ACK: /* SLA+R tx'ed. */
 792:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             /* Let's make sure we ACK the first data byte received (set AA bit in CTRL) unless
 793:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              * the next byte is the last byte of the read transaction.
 794:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              */
 795:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             if (this_i2c->master_rx_size > 1u)
 796:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             {
 797:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 this_i2c->hw_reg->CTRL |= AA_MASK;
 798:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             }
 799:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             else if (1u == this_i2c->master_rx_size)
 800:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             {
 801:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 this_i2c->hw_reg->CTRL &= ~AA_MASK;
 802:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             }
 803:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             else /* this_i2c->master_rx_size == 0u */
 804:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             {
 805:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 this_i2c->hw_reg->CTRL |= AA_MASK;
 806:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 this_i2c->hw_reg->CTRL |= STO_MASK;
 807:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 this_i2c->master_status = MSS_I2C_SUCCESS;
 808:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 this_i2c->transaction = NO_TRANSACTION;
 809:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             }
 810:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             break;
 811:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 812:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****         case ST_SLAR_NACK: /* SLA+R tx'ed; let's release the bus (send a stop condition) */
 813:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             this_i2c->hw_reg->CTRL |= STO_MASK;
 814:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             this_i2c->master_status = MSS_I2C_FAILED;
 815:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 816:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             /*
 817:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              * Set the transaction back to NO_TRANSACTION to allow user to do further
 818:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              * transaction
 819:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              */
 820:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             this_i2c->transaction = NO_TRANSACTION;
 821:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             enable_slave_if_required(this_i2c);
 822:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             break;
 823:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 824:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****         case ST_RX_DATA_ACK: /* Data byte received, ACK returned */
 825:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             /* First, get the data */
 826:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             this_i2c->master_rx_buffer[this_i2c->master_rx_idx] = this_i2c->hw_reg->DATA;
 827:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             this_i2c->master_rx_idx++;
 828:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 829:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             if (this_i2c->master_rx_idx >= (this_i2c->master_rx_size - 1u))
 830:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             {
 831:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 /* If we're at the second last byte, let's set AA to 0 so
 832:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                  * we return a NACK at the last byte. */
 833:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 this_i2c->hw_reg->CTRL &= ~AA_MASK;
 834:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             }
 835:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             break;
 836:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 837:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****         case ST_RX_DATA_NACK: /* Data byte received, NACK returned */
 838:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             /* Get the data, then send a stop condition */
 839:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             this_i2c->master_rx_buffer[this_i2c->master_rx_idx] = this_i2c->hw_reg->DATA;
 840:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 841:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             hold_bus = this_i2c->options &  MSS_I2C_HOLD_BUS;
 842:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 843:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             /* Store the information of current I2C bus status in the bus_status*/
 844:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             this_i2c->bus_status  = hold_bus;
 845:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             if (hold_bus == 0u)
 846:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             {
 847:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 this_i2c->hw_reg->CTRL |= STO_MASK;  /*xmt stop condition */
 848:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 849:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 /* Bus is released, now we can start listening to bus, if it is slave */
 850:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 enable_slave_if_required(this_i2c);
 851:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             }
 852:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             else
 853:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             {
 854:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 PLIC_DisableIRQ(this_i2c->irqn);
 855:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 clear_irq = 0u;
 856:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             }
 857:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 858:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             /*
 859:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              * Set the transaction back to NO_TRANSACTION to allow user to do further
 860:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              * transaction
 861:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              */
 862:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             this_i2c->transaction = NO_TRANSACTION;
 863:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             this_i2c->master_status = MSS_I2C_SUCCESS;
 864:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             break;
 865:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 866:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****         /******************** SLAVE RECEIVER **************************/
 867:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****         case ST_GCA_NACK: /* NACK after, GCA addressing */
 868:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****         case ST_SLA_NACK: /* Re-enable AA (assert ack) bit for future transmissions */
 869:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             this_i2c->hw_reg->CTRL |= AA_MASK;
 870:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 871:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             this_i2c->transaction = NO_TRANSACTION;
 872:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             this_i2c->slave_status = MSS_I2C_SUCCESS;
 873:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 874:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             /* Check if transaction was pending. If yes, set the START bit */
 875:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             if (this_i2c->is_transaction_pending)
 876:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             {
 877:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 this_i2c->hw_reg->CTRL |= STA_MASK ;
 878:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             }
 879:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             break;
 880:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 881:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****         case ST_GCA_LA: /* Arbitr. lost (GCA rec'd) */
 882:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****         case ST_SLV_LA: /* Arbitr. lost (SLA rec'd) */
 883:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             /*
 884:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              *  We lost arbitration and either the GCE or our address was the
 885:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              *  one received so pend the master operation we were starting.
 886:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              */
 887:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             this_i2c->is_transaction_pending = 1u;
 888:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             /* Fall through to normal ST processing as we are now in slave mode */
 889:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 890:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****         case ST_GCA: /* General call address received, ACK returned */
 891:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****         case ST_SLAVE_SLAW: /* SLA+W received, ACK returned */
 892:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 893:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             this_i2c->transaction = WRITE_SLAVE_TRANSACTION;
 894:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             this_i2c->slave_rx_idx = 0u;
 895:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             this_i2c->random_read_addr = 0u;
 896:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 897:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              /* If Start Bit is set, clear it, but store that information since it is because of
 898:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****               * pending transaction
 899:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****               */
 900:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             if (this_i2c->hw_reg->CTRL & STA_MASK)
 901:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             {
 902:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 this_i2c->hw_reg->CTRL &= ~STA_MASK ;
 903:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 this_i2c->is_transaction_pending = 1u;
 904:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             }
 905:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             this_i2c->slave_status = MSS_I2C_IN_PROGRESS;
 906:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 907:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #ifdef MSS_I2C_INCLUDE_SLA_IN_RX_PAYLOAD
 908:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             /* Fall through to put address as first byte in payload buffer */
 909:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #else
 910:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             /* Only break from this case if the slave address must NOT be included at the
 911:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              * beginning of the received write data. */
 912:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             break;
 913:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #endif
 914:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****         case ST_GCA_ACK: /* DATA received; ACK sent after GCA */
 915:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****         case ST_RDATA: /* DATA received; must clear DATA register */
 916:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             if ((this_i2c->slave_rx_buffer != (uint8_t *)0)
 917:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                && (this_i2c->slave_rx_idx < this_i2c->slave_rx_size))
 918:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             {
 919:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 data = this_i2c->hw_reg->DATA;
 920:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 this_i2c->slave_rx_buffer[this_i2c->slave_rx_idx] = data;
 921:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 this_i2c->slave_rx_idx++;
 922:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 923:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #ifdef MSS_I2C_INCLUDE_SLA_IN_RX_PAYLOAD
 924:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 if((ST_RDATA == status) || (ST_GCA_ACK == status))
 925:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 {
 926:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                     /* Ignore the slave address byte in the random read address
 927:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                        computation in the case where INCLUDE_SLA_IN_RX_PAYLOAD
 928:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                        is defined. */
 929:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #endif
 930:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                     this_i2c->random_read_addr = (this_i2c->random_read_addr << 8) + data;
 931:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #ifdef MSS_I2C_INCLUDE_SLA_IN_RX_PAYLOAD
 932:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 }
 933:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** #endif
 934:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             }
 935:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 936:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             if (this_i2c->slave_rx_idx >= this_i2c->slave_rx_size)
 937:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             {
 938:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 this_i2c->hw_reg->CTRL &= ~AA_MASK;   /* send a NACK when done (next reception) */
 939:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             }
 940:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             break;
 941:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 942:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****         case ST_RSTOP:
 943:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             /* STOP or repeated START occurred. */
 944:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             /* We cannot be sure if the transaction has actually completed as
 945:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              * this hardware state reports that either a STOP or repeated START
 946:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              * condition has occurred. We assume that this is a repeated START
 947:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              * if the transaction was a write from the master to this point.*/
 948:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             if (this_i2c->transaction == WRITE_SLAVE_TRANSACTION)
