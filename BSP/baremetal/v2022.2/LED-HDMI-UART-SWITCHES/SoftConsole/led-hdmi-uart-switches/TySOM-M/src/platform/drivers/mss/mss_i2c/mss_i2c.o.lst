 751:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 752:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 /* Store the information of current I2C bus status in the bus_status*/
 753:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 this_i2c->bus_status  = hold_bus;
 754:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 if (hold_bus == 0u)
 755:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 {
 756:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                     this_i2c->hw_reg->CTRL |= STO_MASK; /*xmt stop condition */
