 702:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 703:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             /*
 704:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              * Make sure to update proper transaction after master START
 705:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              * or RESTART
 706:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****              */
 707:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             if (this_i2c->transaction != this_i2c->pending_transaction)
 708:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             {
 709:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 this_i2c->transaction = this_i2c->pending_transaction;
 710:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             }
 711:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             break;
 712:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 713:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****         case ST_LOST_ARB:
 714:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             /* Set start bit.  Let's keep trying!  Don't give up! */
 715:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             this_i2c->hw_reg->CTRL |= STA_MASK;
 716:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             break;
