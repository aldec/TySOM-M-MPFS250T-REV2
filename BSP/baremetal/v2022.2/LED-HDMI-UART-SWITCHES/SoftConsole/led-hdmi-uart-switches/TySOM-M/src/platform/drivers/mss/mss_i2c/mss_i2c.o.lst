 718:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****         /******************* MASTER TRANSMITTER *************************/
 719:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****         case ST_SLAW_NACK:
 720:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             /* SLA+W has been transmitted; not ACK has been received - let's stop. */
 721:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             this_i2c->hw_reg->CTRL |= STO_MASK;
 722:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 723:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             this_i2c->master_status = MSS_I2C_FAILED;
 724:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             this_i2c->transaction = NO_TRANSACTION;
 725:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             enable_slave_if_required(this_i2c);
 726:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             break;
 727:../src/platform/drivers/mss/mss_i2c/mss_i2c.c **** 
 728:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****         case ST_SLAW_ACK:
 729:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****         case ST_TX_DATA_ACK:
 730:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             /* data byte has been xmt'd with ACK, time to send stop bit or repeated start. */
 731:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             if (this_i2c->master_tx_idx < this_i2c->master_tx_size)
 732:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             {
 733:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 this_i2c->hw_reg->DATA = this_i2c->master_tx_buffer[this_i2c->master_tx_idx];
 734:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 this_i2c->master_tx_idx++;
 735:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             }
 736:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             else if ( this_i2c->transaction == MASTER_RANDOM_READ_TRANSACTION )
 737:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             {
 738:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 /* We are finished sending the address offset part of a random read transaction.
 739:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                  * It is is time to send a restart in order to change direction. */
 740:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                  this_i2c->dir = READ_DIR;
 741:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                  this_i2c->hw_reg->CTRL |= STA_MASK;
 742:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             }
 743:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             else /* done sending. let's stop */
 744:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****             {
 745:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 /*
 746:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                  * Set the transaction back to NO_TRANSACTION to allow user to do further
 747:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                  * transaction
 748:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                  */
 749:../src/platform/drivers/mss/mss_i2c/mss_i2c.c ****                 this_i2c->transaction = NO_TRANSACTION;
