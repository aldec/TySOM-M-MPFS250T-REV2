 202:../src/platform/mpfs_hal/common/nwc/mss_pll.c **** }
 203:../src/platform/mpfs_hal/common/nwc/mss_pll.c **** 
 204:../src/platform/mpfs_hal/common/nwc/mss_pll.c **** 
 205:../src/platform/mpfs_hal/common/nwc/mss_pll.c **** /***************************************************************************//**
 206:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****  * mss_mux_post_mss_pll_config(void)
 207:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****  *
 208:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****  * Once MSS locked, feed through to MSS
 209:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****  * We must run this code from RAM, as we need to modify the clock of the eNVM
 210:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****  * The first thing we do is change the eNVM clock, to prevent L1 cache accessing
 211:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****  * eNVM as it will do as we approach the return instruction
 212:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****  * The mb() makes sure order of processing is not changed by the compiler
 213:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****  ******************************************************************************/
 214:../src/platform/mpfs_hal/common/nwc/mss_pll.c **** __attribute__((section(".ram_codetext"))) \
 215:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****         static void mss_mux_post_mss_pll_config(void)
 216:../src/platform/mpfs_hal/common/nwc/mss_pll.c **** {
 217:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****    /*
 218:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * Modify the eNVM clock, so it now matches new MSS clock
 219:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     *
 220:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * [5:0]
 221:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * Sets the number of AHB cycles used to generate the PNVM clock,.
 222:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * Clock period = (Value+1) * (1000/AHBFREQMHZ)
 223:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * Value must be 1 to 63 (0 defaults to 15)
 224:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * e.g.
 225:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * 7 will generate a 40ns period 25MHz clock if the AHB clock is 200MHz
 226:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * 11 will generate a 40ns period 25MHz clock if the AHB clock is 250MHz
 227:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * 15 will generate a 40ns period 25MHz clock if the AHB clock is 400MHz
 228:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     *
 229:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     */
 230:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     SYSREG->ENVM_CR = LIBERO_SETTING_MSS_ENVM_CR;
 231:../src/platform/mpfs_hal/common/nwc/mss_pll.c **** 
 232:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     mb();  /* make sure we change clock in eNVM first so ready by the time we
 233:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****              leave */
 234:../src/platform/mpfs_hal/common/nwc/mss_pll.c **** 
 235:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     /*
 236:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * When you're changing the eNVM clock frequency, there is a bit
 237:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * (ENVM_CR_clock_okay) in the eNVM_CR which can be polled to check that
 238:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * the frequency change has happened before bumping up the AHB frequency.
 239:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     */
 240:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     volatile uint32_t wait_for_true = 0U;
 241:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     while ((SYSREG->ENVM_CR & ENVM_CR_CLOCK_OKAY_MASK) !=\
 242:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****             ENVM_CR_CLOCK_OKAY_MASK)
 243:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     {
 244:../src/platform/mpfs_hal/common/nwc/mss_pll.c **** #ifdef RENODE_DEBUG
 245:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****         break;
 246:../src/platform/mpfs_hal/common/nwc/mss_pll.c **** #endif
 247:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****         wait_for_true++; /* need something here to stop debugger freezing */
 248:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     }
 249:../src/platform/mpfs_hal/common/nwc/mss_pll.c **** 
 250:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****    /*
 251:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * Change the MSS clock as required.
 252:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     *
 253:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * CLOCK_CONFIG_CR
 254:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * [5:0]
 255:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * Sets the master synchronous clock divider
 256:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * bits [1:0] CPU clock divider
 257:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * bits [3:2] AXI clock divider
 258:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * bits [5:4] AHB/APB clock divider
 259:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * 00=/1 01=/2 10=/4 11=/8 (AHB/APB divider may not be set to /1)
 260:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * Reset = 0x3F
 261:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     *
 262:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * SYSREG->CLOCK_CONFIG_CR = (0x0U<<0U) | (0x1U<<2U) | (0x2U<<4U);
 263:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * MSS clk= 80Mhz, implies CPU = 80Mhz, AXI = 40Mhz, AHB/APB = 20Mhz
 264:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * Until we switch in MSS PLL clock (MSS_SCB_CFM_MSS_MUX->MSSCLKMUX = 0x01)
 265:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * e.g. If MSS clk 800Mhz
 266:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * MSS clk= 800Mhz, implies CPU = 800Mhz, AXI = 400Mhz, AHB/APB = 200Mhz
 267:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****    */
 268:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****   SYSREG->CLOCK_CONFIG_CR = LIBERO_SETTING_MSS_CLOCK_CONFIG_CR;
 269:../src/platform/mpfs_hal/common/nwc/mss_pll.c **** 
 270:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****    /*
 271:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * Feed clock from MSS PLL to MSS, using glitch-less mux
 272:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     *
 273:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * MSS Clock mux selections
 274:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     *   [31:5]  Reserved
 275:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     *   [4]    clk_standby_sel
 276:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     *   [3:2]  mssclk_mux_md
 277:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     *   step 7: 7)  MSS Processor writes mssclk_mux_sel_int<0>=1 to select the
 278:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     *   MSS PLL clock.
 279:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     *   [1:0]  mssclk_mux_sel        MSS glitchless mux select
 280:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     *                    00 - msspll_fdr_0=clk_standby
 281:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     *                          msspll_fdr_1=clk_standby
 282:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     *                    01 - msspll_fdr_0=pllout0
 283:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     *                          msspll_fdr_1=clk_standby
 284:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     *                    10 - msspll_fdr_0=clk_standby
 285:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     *                           msspll_fdr_1=pllout1
 286:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     *                    11 - msspll_fdr_0=pllout0
 287:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     *                          msspll_fdr_1=pllout1
 288:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     *
 289:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     *
 290:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     */
 291:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     MSS_SCB_CFM_MSS_MUX->MSSCLKMUX   = LIBERO_SETTING_MSS_MSSCLKMUX;
 292:../src/platform/mpfs_hal/common/nwc/mss_pll.c **** 
 293:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****    /*
 294:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * Change the RTC clock divisor, so RTC clock is 1MHz
 295:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     */
 296:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     set_RTC_divisor();
 297:../src/platform/mpfs_hal/common/nwc/mss_pll.c **** }
 298:../src/platform/mpfs_hal/common/nwc/mss_pll.c **** 
