  93:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****  * mss_mux_pre_mss_pll_config()
  94:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****  *
  95:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****  * Feed through required reference clks to PLL, configure PLL and wait for lock
  96:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****  ******************************************************************************/
  97:../src/platform/mpfs_hal/common/nwc/mss_pll.c **** static void mss_mux_pre_mss_pll_config(void)
  98:../src/platform/mpfs_hal/common/nwc/mss_pll.c **** {
  99:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     /*
 100:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      * PLL RF clk mux selections
 101:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  [31:15] Reserved
 102:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  [14:10] pll1_fdr_sel
 103:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  [9:8]   pll1_rfclk1_sel
 104:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  [7:6]   pll1_rfclk0_sel
 105:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  [5:4]   pll0_rfclk1_sel
 106:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  [3:2]   pll0_rfclk0_sel
 107:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  [1:0]   clk_in_mac_tsu_sel
 108:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *
 109:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  Each mux uses 2 configuration bits. These are decoded as follows:
 110:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  00  vss
 111:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  01  refclk_p,refclk_n
 112:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  10  scb_clk
 113:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  10  serdes_refclk_crn_mss<0>, serdes_refclk_crn_mss<1>
 114:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *
 115:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  e.g.
 116:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  PLL_CKMUX = 0x00000154
 117:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *    pll0_rfclk0_sel = 1 => refclk_p is used for pll0 ref0 and refclk_n is
 118:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *    fed to MSS PLL ref1
 119:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      */
 120:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     /* CFM_MSS 0x3E002000   - 0x08 */
 121:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     MSS_SCB_CFM_MSS_MUX->PLL_CKMUX = LIBERO_SETTING_MSS_PLL_CKMUX;
 122:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     /*
 123:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      * MSS Clock mux selections
 124:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  [31:5]  Reserved
 125:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  [4]     clk_standby_sel
 126:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  [3:2]   mssclk_mux_md
 127:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  step 7: 7)  MSS Processor writes mssclk_mux_sel_int<0>=1 to select the
 128:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  MSS PLL clock.
 129:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  [1:0]   mssclk_mux_sel        MSS glitchless mux select
 130:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *                                      00 - msspll_fdr_0=clk_standby
 131:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *                                           msspll_fdr_1=clk_standby
 132:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *                                      01 - msspll_fdr_0=pllout0
 133:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *                                           msspll_fdr_1=clk_standby
 134:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *                                      10 - msspll_fdr_0=clk_standby
 135:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *                                           msspll_fdr_1=pllout1
 136:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *                                      11 - msspll_fdr_0=pllout0
 137:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *                                           msspll_fdr_1=pllout1
 138:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *
 139:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *
 140:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      */
 141:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     /*
 142:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      * We will not set as already set to 0, we feed through after we have setup
 143:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      * clock
 144:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      * MSS_SCB_CFM_MSS_MUX->MSSCLKMUX           = LIBERO_SETTING_MSS_MSSCLKMUX;
 145:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      */
 146:../src/platform/mpfs_hal/common/nwc/mss_pll.c **** 
 147:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     /*
 148:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      * Clock_Receiver
 149:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  [13]    en_rdiff
 150:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  [12]    clkbuf_en_pullup
 151:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  [11:10] en_rxmode_n
 152:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  [9:8]   en_term_n
 153:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  [7]     en_ins_hyst_n
 154:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  [6]     en_udrive_n
 155:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  [5:4]   en_rxmode_p
 156:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  [3:2]   en_term_p
 157:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  [1]     en_ins_hyst_p
 158:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  [0]     en_udrive_p
 159:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      */
 160:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     MSS_SCB_CFM_SGMII_MUX->CLK_XCVR         = LIBERO_SETTING_SGMII_CLK_XCVR;
 161:../src/platform/mpfs_hal/common/nwc/mss_pll.c **** 
 162:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     /*
 163:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      * 29:25    bclk5_sel
 164:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      * 24:20    bclk4_sel
 165:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      * 19:15    bclk3_sel
 166:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      * 14:10    bclk2_sel
 167:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      * 9:5  bclk1_sel
 168:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      * 4:0  bclk0_sel
 169:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *
 170:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      * From SAC spec:
 171:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      * Table 9 1: Each gbim bank clock mux programming in MSS corner
 172:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      * The DDRPHY bank clocks bclk_horz<5:0> and bclk_vert<5:0> are driven
 173:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      * from mux's gbim<5:0> in the MSS corner. Each mux uses 5 configuration
 174:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      * bits.
 175:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *
 176:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      * BCLK mux selections
 177:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  bclk0_sel=0x8 (pll0_out_1k<2> selected)
 178:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  bclk1_sel=0x10 (pll0_out_1k<3> selected)
 179:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  bclk2_sel=0x1 (vss selected)
 180:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  bclk3_sel=0x1 (vss selected)
 181:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  bclk4_sel=0x1 (vss selected)
 182:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  bclk5_sel=0x1 (vss selected)
 183:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *
 184:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      */
 185:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     MSS_SCB_CFM_MSS_MUX->BCLKMUX        =   LIBERO_SETTING_MSS_BCLKMUX;
 186:../src/platform/mpfs_hal/common/nwc/mss_pll.c **** 
 187:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     /*  MSS_SCB_CFM_MSS_MUX->SPARE0         =   BCLKMUX_USER_CONFIG;       */
 188:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     MSS_SCB_CFM_MSS_MUX->FMETER_ADDR    =   LIBERO_SETTING_MSS_FMETER_ADDR;
 189:../src/platform/mpfs_hal/common/nwc/mss_pll.c **** 
 190:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     MSS_SCB_CFM_MSS_MUX->FMETER_DATAW   =   LIBERO_SETTING_MSS_FMETER_DATAW;
 191:../src/platform/mpfs_hal/common/nwc/mss_pll.c **** 
 192:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     MSS_SCB_CFM_MSS_MUX->FMETER_DATAR   =   LIBERO_SETTING_MSS_FMETER_DATAR;
 193:../src/platform/mpfs_hal/common/nwc/mss_pll.c **** 
 194:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     /*
 195:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *
