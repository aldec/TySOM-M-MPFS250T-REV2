 188              	 /***********************************************************************************
 189              	 *
 190              	 * fill_cache_new_seg_address and flush
 191              	 */
 192              	    .equ    L2_CCACHE_ADDR, 0x02010000
 193              	    .equ    FLUSH64_OFFSET, 0x200
 194              	    //
 195              	    // We want to flush anything that may be cached
 196              	    // with previous seg settings
 197              	    //
 198              	    // The cache block is 64-bytes wide, and there are 4 banks * 512 sets * 16
 199              	    // ways.
 200              	    // We just write to the DDR cache backed address passed by the caller
 201              	    // Once start and end address range covers the size of the cache, the
 202              	    // previous contents of cache will be overwritten.
 203              	    //
 204              	    // fill_cache_new_seg_address
 205              	    //  a0 = dest
 206              	    //  a1 = dest end address
 207              	    .globl  fill_cache_new_seg_address
 209              	fill_cache_new_seg_address:
 210 00be 2A83     	    mv  t1,a0
 211 00c0 AE83     	    mv  t2,a1
 212 00c2 2A8E     	    mv  t3,a0
 213              	
 214              	.preload_cache_with_known_addrs:
 215 00c4 23300300 	    sd  x0, 0(t1)
 216 00c8 833E0300 	    ld  t4, 0(t1)
 217 00cc 13030304 	    addi    t1, t1, 64
 218 00d0 E34A73FE 	    blt t1, t2, .preload_cache_with_known_addrs
 219              	
 220              	    //
 221              	    // Now that the cache is filled with known addresses, we can simply flush
 222              	    // each known address to end up with an empty cache.
 223              	    // There is no requirement to clear the cache, but we will as a belt and
 224              	    // braces excercise before we continue with the boot process
 225              	    //
 226 00d4 37030102 	    li  t1, L2_CCACHE_ADDR
 227              	.flush_known_addrs_from_cache:
 228 00d8 2330C321 	    sd  t3, FLUSH64_OFFSET(t1)      // write address to 0x02010200 (FLUSH64)
 229 00dc 130E0E04 	    addi    t3, t3, 64
 230 00e0 E34C7EFE 	    blt t3, t2, .flush_known_addrs_from_cache
 231              	
 232              	.early_exit:
 233 00e4 82800000 	    ret
