 113 0074 0503     	    addi    t1,t1,1
 114 0076 8505     	    addi    a1,a1,1
 115 0078 6DFA     	    bnez    a2,1b
 116              	2:
 117 007a 8280     	    ret
 118              	
 119              	 /***********************************************************************************
