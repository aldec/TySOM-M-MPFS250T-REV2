  16              	  .section .text.init,"ax", %progbits
  17 0000 01001300 	  .align 3
  17      0000
  18              	
  19              	/***********************************************************************************
  20              	 *
  21              	 * pdma_transfer
  22              	 * Only used by the mpfs hal. App code uses the provided driver.
  23              	 *
  24              	 *   a0 = dest
  25              	 *   a1 = src
  26              	 *   a2 = length
  27              	 *   a3 = PDMA Base Address - 0x3000000 + (0x01000 * PDMA_CHANNEL)
  28              	 */
  29              	    .globl  pdma_transfer
  31              	pdma_transfer:
  32 0006 2A83     	    mv  t1,a0
  33 0008 B682     	    mv t0, a3           // Base address
  34 000a 0543     	    li t1, 1
  35 000c 23A06200 	    sw t1, 0(t0)        // claim
  36 0010 0143     	    li t1, 0
  37 0012 23A26200 	    sw t1, 4(t0)        // read[31:28]/write[27:24] size 0=>1byte, 1 =>2 bytes etx
  38 0016 3283     	    mv t1, a2           // SIZE
  39 0018 23B46200 	    sd t1, 8(t0)        // bytes
  40 001c 2A83     	    mv t1, a0           // dest address
  41 001e 23B86200 	    sd t1, 16(t0)       // dest
  42 0022 2E83     	    mv t1, a1           // source address
  43 0024 23BC6200 	    sd t1, 24(t0)       // src
  44 0028 1B03F00F 	    li t1, 0xff000000
  44      13138301 
  45 0030 23A26200 	    sw t1, 4(t0)        // full speed copy
  46 0034 0D43     	    li t1, 3
  47 0036 23A06200 	    sw t1, 0(t0)        // start transfer
  48 003a 0F00F00F 	    fence
  49 003e 8280     	    ret
  50              	
  51              	/***********************************************************************************
  52              	 *
  53              	 * pdma_transfer_complete
  54              	 * Loops until transfer complete
  55              	 * Only used by the mpfs hal. App code uses the provided driver.
  56              	 *
  57              	 *    a0 = PDMA Base Address - 0x3000000 + (0x01000 * PDMA_CHANNEL)
  58              	 */
  59              	    //
  60              	    .globl  pdma_transfer_complete
  62              	pdma_transfer_complete:
  63 0040 AA82     	    mv t0, a0           // Base address
  64              	1: // wait for completion
  65 0042 03A30200 	    lw t1, 0(t0)
  66 0046 13732300 	    andi t1, t1, 2
  67 004a E31C03FE 	    bnez t1, 1b
  68              	    // release DMA
  69 004e 23A00200 	    sw zero, 0(t0)
  70 0052 8280     	    ret
  71              	
  72              	
  73              	 /***********************************************************************************
  74              	 *
  75              	 * memfill() - fills memory, alternate to lib function when not available
  76              	 */
  77              	    // memfill helper function:
  78              	    //  a0 = dest
  79              	    //  a1 = value to fill
  80              	    //  a2 = length
  81              	    .globl  memfill
  83              	memfill:
  84 0054 2A83     	    mv  t1,a0
  85 0056 AE83     	    mv  t2,a1
  86 0058 11C6     	    beqz    a2,2f
  87              	1:
  88 005a 23007300 	    sb  t2,0(t1)
  89 005e 7D16     	    addi    a2,a2,-1
  90 0060 0503     	    addi    t1,t1,1
  91 0062 65FE     	    bnez    a2,1b
  92              	2:
  93 0064 8280     	    ret
  94              	
  95              	/***********************************************************************************
  96              	 *
  97              	 * The following config_copy() symbol overrides the weak symbol in the HAL and does
  98              	 * a safe copy of HW config data
  99              	 */
 100              	    // config_copy helper function:
 101              	    //  a0 = dest
 102              	    //  a1 = src
 103              	    //  a2 = length
 104              	    .globl  config_copy
 106              	config_copy:
 107 0066 2A83     	    mv  t1,a0
 108 0068 09CA     	    beqz    a2,2f
