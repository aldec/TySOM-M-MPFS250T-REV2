 165              	 /***********************************************************************************
 166              	 *
 167              	 * config_64_copy - copying using 64 bit loads, addresses must be on 64 bit boundary
 168              	 */
 169              	    // config_64_copy helper function:
 170              	    //  a0 = dest
 171              	    //  a1 = src
 172              	    //  a2 = length
 173              	    .globl  config_64_copy
