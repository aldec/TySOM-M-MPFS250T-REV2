 472:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      *              soft_reset_periph_b,
 473:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      *              calib_lock,             w/r in reg     IOC_REG0
