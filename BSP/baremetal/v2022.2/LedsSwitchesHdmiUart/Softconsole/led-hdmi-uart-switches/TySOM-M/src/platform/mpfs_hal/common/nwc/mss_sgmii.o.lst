  92:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      *      SGMII
  93:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      *      DDR
  94:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      *      IOMUX
  95:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      */
  96:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c **** 
  97:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****     switch(sgmii_training_state)
  98:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****     {
  99:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****         case SGMII_SETUP_INIT:
 100:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             status = SGMII_IN_SETUP;
 101:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             CFG_DDR_SGMII_PHY->SOFT_RESET_SGMII.SOFT_RESET_SGMII = \
 102:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****                     (0x01 << 8U) | 1U; /* PERIPH   soft reset */
 103:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             CFG_DDR_SGMII_PHY->SOFT_RESET_SGMII.SOFT_RESET_SGMII = 1U;
 104:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             setup_sgmii_rpc_per_config();         /* load RPC SGMII_MODE register ext */
 105:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c **** 
 106:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             /* Enable the Bank controller */
 107:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             /*
 108:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * Set soft reset on IP to load RPC to SCB regs (dynamic mode)
 109:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * Bring the sgmii bank controller out of reset =- ioscb_bank_ctrl_sgmii
 110:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              */
 111:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             IOSCB_BANK_CNTL_SGMII->soft_reset = 1U;  /* DPC_BITS NV_MAP  reset */
 112:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             sgmii_training_state = SGMII_IO_EN;
 113:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             break;
 114:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c **** 
 115:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****         case SGMII_IO_EN:
 116:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             /*
 117:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * Check the IO_EN signal here.
 118:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * This is an output from the bank controller power detector, which are
 119:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * turned on using MSS_IO_EN
 120:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              */
 121:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             /* aro_ioen_bnk  - PVT calibrator IOEN  */
 122:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             timer_out++;
 123:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             if((CFG_DDR_SGMII_PHY->PVT_STAT.PVT_STAT & (0x01U<<6U)) != 0U)
 124:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             {
 125:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****                 timer_out=0U;
 126:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****                 sgmii_training_state = SGMII_RAMP_TIMER;
 127:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             }
 128:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             break;
 129:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c **** 
 130:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****         case SGMII_RAMP_TIMER:
 131:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             /*
 132:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * IO power ramp wait time
 133:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * After IOEN is received from power detectors DDR and SGMii, extra time
 134:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * required for voltage to ramp.
 135:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * This time will come from the user- Dependent on ramp time of power
 136:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * supply
 137:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * Approximately - Bank power timer (from ioen_in to ioen_out = 10uS)?
 138:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              *
 139:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              */
 140:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             timer_out++;
 141:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             if(timer_out >= 0xFU)
 142:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             {
 143:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****                 timer_out=0U;
 144:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****                 sgmii_training_state = SGMII_IO_SETUP;
 145:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             }
 146:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             break;
 147:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c **** 
 148:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****         case SGMII_IO_SETUP:
 149:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             /*
 150:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * fixme- not sure if we should be setting this register
 151:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * From regmap detail:
 152:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * bit 8 of MSS_RESET_CR
 153:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * Asserts a reset the SGMII block containing the MSS reference clock
 154:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * input.
 155:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * Warning that setting this bit causes the external reference clock
 156:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * input to the
 157:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * MSS PLL to disappear.
 158:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * It is advisable to use the SGMII channel soft resets in the PHY
 159:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * instead of this bit.
 160:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * However if E51 software wants to set this bit, the MSS clock source
 161:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * should be switched over to the standby source in advance.
 162:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              */
 163:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             SCB_REGS->MSS_RESET_CR.MSS_RESET_CR = 0;
 164:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c **** 
 165:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             /*
 166:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * I ran the sim past the place where we set the nvmap_reset in the
 167:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * SOFT_RESET_SGMII register and it did not result in any
 168:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * change from the DLL default bits.
 169:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * But I traced the 'flashing' signal on one of these regs back to
 170:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * 'dll0_soft_reset_nv_map' (not 'pll0_soft_reset_periph').
 171:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * Now the only place I can find 'dll0_soft_reset_nv_map' is in SCB
 172:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * space...ie 0x3e10_0000 SOFT_RESET register.
 173:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              *
 174:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              */
 175:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             /*
 176:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * so we have to use scb register to reset as no APB register available
 177:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * to soft reset the IP
 178:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * ioscb_dll_sgmii
 179:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * */
 180:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             IOSCB_DLL_SGMII->soft_reset = (0x01U << 0x00U);  /*  reset sgmii DLL */
 181:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c **** 
 182:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             /*
 183:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****               * I have discovered the problem with the tx channels (soft reset issue)
 184:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****               * So we require the:
 185:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****               *
 186:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****               * sgmiiphy_lane 01 soft-reset register (0x3650_0000) to be written to
 187:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****               * with 0x1 (to set the nv_map bit[0] =1 (self clears))
 188:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****               * same for sgmiiphy_lane 23 soft-reset register (0x3651_0000).
 189:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****               *
 190:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****               * This will result in the rpc bits for the Lane controls to get loaded.
 191:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****               * Not happening currently.
 192:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****               *
 193:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****               * The soft_reset_sgmii occurs in the mss_ddr.c line 436, so I suppose
 194:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****               * we put the 2 new soft reset writes after that.
 195:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****               *
 196:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****               */
 197:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             {
 198:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****                 /* sgmiiphy_lane 01 soft-reset register (0x3650_0000) */
 199:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****                 SGMIIPHY_LANE01->soft_reset = 0x000000001U;
 200:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****                 /* sgmiiphy_lane 23 soft-reset register (0x3650_0000) */
 201:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****                 SGMIIPHY_LANE23->soft_reset = 0x000000001U;
 202:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             }
 203:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c **** 
 204:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             /*
 205:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * Kick-off calibration, by taking calibration IP out of reset
 206:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              */
 207:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             /*
 208:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              * Soft reset
 209:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****              */
 210:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****             {
 211:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****                 /* PVT soft reset - APB*/
