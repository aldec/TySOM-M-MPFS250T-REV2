  25:../src/platform/drivers/mss/mss_gpio/mss_gpio.c **** /*These constants define the number of GPIO bits available on each GPIO
  26:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****  * hardware block*/
  27:../src/platform/drivers/mss/mss_gpio/mss_gpio.c **** #define NB_OF_GPIO_GPIO0                    ((uint32_t)14)
  28:../src/platform/drivers/mss/mss_gpio/mss_gpio.c **** #define NB_OF_GPIO_GPIO1                    ((uint32_t)24)
  29:../src/platform/drivers/mss/mss_gpio/mss_gpio.c **** #define NB_OF_GPIO_GPIO2                    ((uint32_t)32)
  30:../src/platform/drivers/mss/mss_gpio/mss_gpio.c **** 
  31:../src/platform/drivers/mss/mss_gpio/mss_gpio.c **** /*This constant indicates the total number of GPIO interrupt inputs at the PLIC
  32:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****  * (includes the direct and non-direct GPIO interrupts)*/
  33:../src/platform/drivers/mss/mss_gpio/mss_gpio.c **** #define NB_OF_GPIO_INTR                     ((uint32_t)41)
  34:../src/platform/drivers/mss/mss_gpio/mss_gpio.c **** 
  35:../src/platform/drivers/mss/mss_gpio/mss_gpio.c **** /*-------------------------------------------------------------------------*//**
  36:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****  * Lookup table of GPIO interrupt number indexed on GPIO ID.
  37:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****  * The GPIO interrupts are multiplexed. Total GPIO interrupts are 41.
  38:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****  * 41 = (14 from GPIO0 + 24 from GPIO1 + 3 non direct interrupts)
  39:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****  * GPIO2 interrupts are not available by default. Setting the corresponding bit
  40:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****  * in GPIO_INTERRUPT_FAB_CR(31:0) will enable GPIO2(31:0) corresponding
  41:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****  * interrupt on PLIC.
  42:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****  *
  43:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****  * PLIC       GPIO_INTERRUPT_FAB_CR
  44:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****                 0               1
  45:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     0       GPIO0 bit 0     GPIO2 bit 0
  46:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     1       GPIO0 bit 1     GPIO2 bit 1
  47:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     .
  48:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     .
  49:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     12      GPIO0 bit 12    GPIO2 bit 12
  50:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     13      GPIO0 bit 13    GPIO2 bit 13
  51:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     14      GPIO1 bit 0     GPIO2 bit 14
  52:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     15      GPIO1 bit 1     GPIO2 bit 15
  53:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     .
  54:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     .
  55:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     .
  56:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     30      GPIO1 bit 16    GPIO2 bit 30
  57:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     31      GPIO1 bit 17    GPIO2 bit 31
  58:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     32          GPIO1 bit 18
  59:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     33          GPIO1 bit 19
  60:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     34          GPIO1 bit 20
  61:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     35          GPIO1 bit 21
  62:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     36          GPIO1 bit 22
  63:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     37          GPIO1 bit 23
  64:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     38  Or of all GPIO0 interrupts who do not have a direct connection enabled
  65:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     39  Or of all GPIO1 interrupts who do not have a direct connection enabled
  66:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     40  Or of all GPIO2 interrupts who do not have a direct connection enabled
  67:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****  *
  68:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****  */
  69:../src/platform/drivers/mss/mss_gpio/mss_gpio.c **** static const PLIC_IRQn_Type g_gpio_irqn_lut[NB_OF_GPIO_INTR] =
  70:../src/platform/drivers/mss/mss_gpio/mss_gpio.c **** {
