 237:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****  * See "mss_gpio.h" for details of how to use this function.
 238:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****  */
 239:../src/platform/drivers/mss/mss_gpio/mss_gpio.c **** void MSS_GPIO_drive_inout
 240:../src/platform/drivers/mss/mss_gpio/mss_gpio.c **** (
 241:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     GPIO_TypeDef * gpio,
 242:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     mss_gpio_id_t port_id,
 243:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     mss_gpio_inout_state_t inout_state
 244:../src/platform/drivers/mss/mss_gpio/mss_gpio.c **** )
 245:../src/platform/drivers/mss/mss_gpio/mss_gpio.c **** {
 246:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     uint32_t config;
 247:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     
 248:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     if (0U == gpio_number_validate(gpio, port_id))
 249:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     {
 250:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****         switch (inout_state)
 251:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****         {
 252:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****             case MSS_GPIO_DRIVE_HIGH:
 253:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****                 /* Set output high */
 254:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****                 gpio->GPIO_SET_BITS = ((uint32_t)1 << port_id);
 255:../src/platform/drivers/mss/mss_gpio/mss_gpio.c **** 
 256:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****                 /* Enable output buffer */
 257:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****                 config = gpio->GPIO_CFG[port_id];
 258:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****                 config |= OUTPUT_BUFFER_ENABLE_MASK;
 259:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****                 gpio->GPIO_CFG[port_id] = config;
 260:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****             break;
 261:../src/platform/drivers/mss/mss_gpio/mss_gpio.c **** 
 262:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****             case MSS_GPIO_DRIVE_LOW:
 263:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****                 /* Set output low */
 264:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****                 gpio->GPIO_CLR_BITS = (uint32_t)1 << port_id;
 265:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****                 /* Enable output buffer */
 266:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****                 config = gpio->GPIO_CFG[port_id];
 267:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****                 config |= OUTPUT_BUFFER_ENABLE_MASK;
 268:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****                 gpio->GPIO_CFG[port_id] = config;
 269:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****             break;
 270:../src/platform/drivers/mss/mss_gpio/mss_gpio.c **** 
 271:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****             case MSS_GPIO_HIGH_Z:
 272:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****                 /* Disable output buffer */
 273:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****                 config = gpio->GPIO_CFG[port_id];
 274:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****                 config &= ~OUTPUT_BUFFER_ENABLE_MASK;
 275:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****                 gpio->GPIO_CFG[port_id] = config;
 276:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****             break;
 277:../src/platform/drivers/mss/mss_gpio/mss_gpio.c **** 
 278:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****             default:
 279:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****                 ASSERT(0);
 280:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****             break;
 281:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****         }
 282:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     }
 283:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     else
 284:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     {
 285:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****         ASSERT(0); /*LDRA warning*/
 286:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     }
 287:../src/platform/drivers/mss/mss_gpio/mss_gpio.c **** }
