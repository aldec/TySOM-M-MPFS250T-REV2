 204:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****  * See "mss_gpio.h" for details of how to use this function.
 205:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****  */
 206:../src/platform/drivers/mss/mss_gpio/mss_gpio.c **** void MSS_GPIO_set_output
 207:../src/platform/drivers/mss/mss_gpio/mss_gpio.c **** (
 208:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     GPIO_TypeDef * gpio,
 209:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     mss_gpio_id_t port_id,
 210:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     uint8_t value
 211:../src/platform/drivers/mss/mss_gpio/mss_gpio.c **** )
 212:../src/platform/drivers/mss/mss_gpio/mss_gpio.c **** {
 213:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     if (0U == gpio_number_validate(gpio, port_id))
 214:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     {
 215:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****         /* Setting the bit in GPIO_SET_BITS (offset 0xA4) sets the corresponding
 216:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****          * output port.
 217:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****          * Setting the bit in GPIO_CLR_BITS (offset 0xA0) clears the
 218:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****          * corresponding output port.*/
 219:../src/platform/drivers/mss/mss_gpio/mss_gpio.c **** 
 220:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****         if (value > 0u)
 221:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****         {
 222:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****             gpio->GPIO_SET_BITS = ((uint32_t)0x01 << port_id);
 223:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****         }
 224:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****         else
 225:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****         {
 226:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****             gpio->GPIO_CLR_BITS = ((uint32_t)0x01 << port_id);
 227:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****         }
 228:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     }
 229:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     else
 230:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     {
 231:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****         ASSERT(0); /*LDRA warning*/
 232:../src/platform/drivers/mss/mss_gpio/mss_gpio.c ****     }
 233:../src/platform/drivers/mss/mss_gpio/mss_gpio.c **** }
