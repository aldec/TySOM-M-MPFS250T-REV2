  33:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /* This string is updated if any change to ddr driver */
  34:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** #define DDR_DRIVER_VERSION_STRING   "0.4.023"
  35:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** const char DDR_DRIVER_VERSION[] = DDR_DRIVER_VERSION_STRING;
  36:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /* Version     |  Comment                                                     */
  37:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /* 0.4.023     |  Changed default ADDCMD CLK push order for DDR4 to 0,45,90   */
  38:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /* 0.4.022     |  Tidied comments and simulation reference- no code change    */
  39:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /* 0.4.021     |  Added options to increase post training tests during        */
  40:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /*             |  verification. The following defines can be added to         */
  41:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /*             |  mss_sw_config.h during verification of a new hardware       */
  42:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /*             |  design to overwrite the default values:                     */
  43:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /*             |  (#define PATTERN_TEST_NUM_PATTERN_IN_CACHE_READS  2U)       */
  44:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /*             |  (#define PATTERN_TEST_NUM_OFFSET_INCS             16U)      */
  45:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /*             |  (#define PATTERN_TEST_SIZE                0x40000000U)      */
  46:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /* 0.4.020     |  Added user option to turn on clk push during addcmd         */
  47:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /*             |  training for DDR4 and lpddr3. The following define enables: */
  48:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /*             |  (#define LIBERO_SETTING_USE_CK_PUSH_DDR4_LPDDR3    1U)      */
