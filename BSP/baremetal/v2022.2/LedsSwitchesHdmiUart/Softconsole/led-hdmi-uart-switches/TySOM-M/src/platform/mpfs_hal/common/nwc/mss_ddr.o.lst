2802:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      * Recheck read, if first read successful
2803:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      */
2804:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     if(error == 0)
2805:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     {
