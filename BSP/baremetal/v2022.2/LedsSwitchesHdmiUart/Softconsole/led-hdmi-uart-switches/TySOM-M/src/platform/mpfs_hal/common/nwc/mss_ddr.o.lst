3415:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         if((result == 0U)&&(calib_data.mem_vref.lower == MEM_VREF_INVALID))
3416:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         {
