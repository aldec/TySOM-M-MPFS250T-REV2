2810:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         {
2811:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             if( *DDR_word_ptr != test_string[i & 0xfU])
2812:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             {
2813:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                 ddr_error_count++;
2814:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                 error = 1;
2815:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             }
2816:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             ++i;
2817:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             DDR_word_ptr = DDR_word_ptr + 1U;
2818:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         }
2819:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     }
2820:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     return error;
2821:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** }
2822:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** #endif
