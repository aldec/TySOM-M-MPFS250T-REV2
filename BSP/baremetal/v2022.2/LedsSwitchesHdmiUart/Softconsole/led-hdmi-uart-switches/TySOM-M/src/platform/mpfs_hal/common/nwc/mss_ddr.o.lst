3067:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     uint64_t start_address = 0x0000000000000000ULL;
3068:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     uint32_t size = ONE_MB_MTC;  /* Number of reads for each iteration 2**size*/
3069:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
3070:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     calib_data.write_cal.status_lower = 0U;
3071:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     /*
3072:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      * bit 3  must be set if we want to use the
3073:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      * expert_wrcalib
3074:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      * register
3075:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      */
3076:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     CFG_DDR_SGMII_PHY->expert_mode_en.expert_mode_en = 0x00000008U;
3077:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
3078:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     /*
3079:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      * training carried out here- sweeping write calibration offset from 0 to F
3080:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      * Explanation: A register, expert_wrcalib, is described in MSS DDR TIP
3081:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      * Register Map [1], and its purpose is to delay--by X number of memory clock
3082:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      * cycles--the write data, write data mask, and write output enable with the
3083:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      * respect to the address and command for each lane.
3084:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      */
3085:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     for (cal_data=0x00000U;cal_data<0xfffffU;cal_data=cal_data+0x11111U)
3086:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     {
3087:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** #ifdef DEBUG_DDR_INIT
3088:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         (void)uprint32(g_debug_uart, "\n\rCalibration offset used:",cal_data &0xFUL);
3089:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** #endif
3090:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         CFG_DDR_SGMII_PHY->expert_wrcalib.expert_wrcalib = cal_data;
3091:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
3092:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         for (laneToTest = 0x00U; laneToTest<number_of_lanes_to_calibrate;\
3093:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                                                                 laneToTest++)
3094:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         {
3095:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             /*
3096:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****              * read once to flush MTC. During write calibration the first MTC read
3097:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****              * must be discarded as it is unreliable after a series of bad writes.
3098:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****              */
3099:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             uint8_t mask = (uint8_t)(1U<<laneToTest);
3100:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             result = MTC_test(mask, start_address, size, MTC_COUNTING_PATTERN, MTC_ADD_SEQUENTIAL, 
3101:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             /* Read using different patterns */
3102:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             if(result == 0U)
3103:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             {
3104:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                 result |= MTC_test(mask, start_address, size, MTC_PSEUDO_RANDOM, MTC_ADD_SEQUENTIAL
3105:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                 result |= MTC_test(mask, start_address, size, MTC_COUNTING_PATTERN, MTC_ADD_SEQUENT
3106:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                 result |= MTC_test(mask, start_address, size, MTC_WALKING_ONE, MTC_ADD_SEQUENTIAL, 
3107:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                 result |= MTC_test(mask, start_address, size, MTC_PSEUDO_RANDOM, MTC_ADD_SEQUENTIAL
3108:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                 result |= MTC_test(mask, start_address, size, MTC_NO_REPEATING_PSEUDO_RANDOM, MTC_A
