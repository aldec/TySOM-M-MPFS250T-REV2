3052:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  * write_calibration_using_mtc
3053:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *   Use Memory Test Core plugged in to the front end of the DDR controller to
3054:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *   perform lane-based writes and read backs and increment write calibration
3055:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *   offset for each lane until data match occurs. The Memory Test Core is the
3056:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *   basis for all training.
3057:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *
3058:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  * @param number_of_lanes_to_calibrate
3059:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  * @return
3060:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  */
3061:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** static uint8_t \
3062:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     write_calibration_using_mtc(uint8_t number_of_lanes_to_calibrate)
3063:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** {
