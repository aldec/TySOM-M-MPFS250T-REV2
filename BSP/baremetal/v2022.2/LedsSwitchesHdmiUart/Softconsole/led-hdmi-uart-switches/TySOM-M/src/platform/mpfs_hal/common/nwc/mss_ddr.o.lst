 263:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     {
 264:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         ddr_state = DDR_STATE_INIT;
 265:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     }
 266:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
 267:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     switch (ddr_state)
 268:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     {
 269:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         default:
 270:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         case DDR_STATE_INIT:
