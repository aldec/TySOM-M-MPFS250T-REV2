3245:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     /* CFG_DDR_SGMII_PHY->DPC_BITS.bitfield.dpc_vrgen_h; */
3246:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     /* CFG_DDR_SGMII_PHY->DPC_BITS.bitfield.dpc_vrgen_v; */
3247:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
3248:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     }
