4531:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /*-------------------------------------------------------------------------*//**
4532:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****   The MSS_DDR_status() function is used to return status information to the
4533:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****   user.
4534:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
4535:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****   TODO: Define number of request inputs
4536:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
4537:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****    @param option
4538:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     This option chooses status data we wish returned
4539:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
4540:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****    @param return_data
4541:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     Returned data here. This must be within a defined range.
4542:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     todo:Detail on the sharing of data will be system dependent.
4543:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     AMP/SMU detail to be finalized at time of writing
4544:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
4545:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****   @return
4546:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     Returns 0 on success.
4547:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     TODO: Define error codes.
4548:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
4549:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****   Example:
4550:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     The call to MSS_DDR_status(DDR_TYPE, return_data) will return 0 if
4551:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     successful and the DDR type in the first four bytes of the ret_mem area.
4552:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     @code
4553:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     MSS_DDR_status( DDR_TYPE, ret_mem );
4554:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     @endcode
4555:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  */
4556:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** uint8_t
4557:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** MSS_DDR_status
4558:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** (
4559:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     uint8_t option, uint32_t *return_data
