2543:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /**
2544:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****   Info on OFF modes:
2545:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
2546:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****   OFF MODE from reset- I/O not being used
2547:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         MSSIO from reset- non default values
2548:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             Needs non default values to completely go completely OFF
2549:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             Drive bits and ibuff mode
2550:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             Ciaran to define what need to be done
2551:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****               SAR107676
2552:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         DDR - by default put to DDR4 mode so needs active intervention
2553:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             Bills sac spec (DDR PHY SAC spec section 6.1)
2554:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             Mode register set to 7
2555:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             Ibuff mode set to 7 (rx turned off)
2556:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             P-Code/ N-code of no relevance as not used
2557:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             Disable DDR PLL
2558:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                Will be off from reset- no need
2559:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             Need to reflash
2560:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             DDR APB ( three resets - soft reset bit 0 to 1)
2561:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                 Drive odt etc
2562:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****        SGMII - from reset nothing to be done
2563:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****            See Jeff's spread sheet- default values listed
2564:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****            Extn clock off also defined in spread sheet
2565:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  */
2566:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
2567:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
2568:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /**
2569:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  ddr_off_mode(void)
2570:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  Assumed in Dynamic mode.
2571:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  i.e.
2572:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  SCB dynamic enable bit is high
2573:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  MSS core_up = 1
2574:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  dce[0,1,2] 0,0,0
2575:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  flash valid = 1
2576:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  IP:
2577:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  DECODER_DRIVER, ODT, IO all out of reset
2578:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *
2579:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  DDR PHY off mode that I took from version 1.58 of the DDR SAC spec.
2580:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  1.  DDR PHY OFF mode (not used at all).
2581:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  1.  Set the DDR_MODE register to 7
2582:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  This will disable all the drive and ODT to 0, as well as set all WPU bits.
2583:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  2.  Set the RPC_IBUF_MD_* registers to 7
2584:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  This will disable all receivers.
2585:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  3.  Set the REG_POWERDOWN_B register to 0
2586:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  This will disable the DDR PLL
2587:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *
2588:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  */
2589:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** static void ddr_off_mode(void)
2590:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** {
2591:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     /*
2592:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * DDR PLL is not turn on on reset- so no need to do anything
2593:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       */
2594:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      /*
2595:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * set the mode register to 7 => off mode
2596:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * From the DDRPHY training firmware spec.:
2597:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * If the DDR interface is unused, the firmware will have to write 3'b111
2598:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * into the APB_DDR_MODE register. This will disable all the DRIVERs, ODT
2599:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * and INPUT  receivers.
2600:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * By default, WPD will be applied to all pads.
2601:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       *
2602:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * If a user wants to apply WPU, this will have to be applied through
2603:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * firmware, by changing all RPC_WPU_*=0, and RPC_WPD_*=1, via APB register
2604:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * writes.
2605:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       *
2606:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * Unused IO within an interface will automatically be shut off, as unused
2607:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * DQ/DM/DQS/and CA buffers and odt are automatically disabled by the
2608:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * decode, and put into WPD mode.
2609:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * Again, if the user wants to change this to WPU, the will have to write
2610:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * RPC_WPU_*=0 and RPC_WPD_*=1 to override the default.
2611:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       *
2612:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       */
2613:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      /* Note: DMI_DBI [8:1]   needs to be 0 (off) during training */
2614:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      CFG_DDR_SGMII_PHY->DDRPHY_MODE.DDRPHY_MODE  =\
2615:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****              (LIBERO_SETTING_DDRPHY_MODE_OFF /* & DMI_DBI_MASK */);
2616:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      /*
2617:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * VS for off mode
2618:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       */
2619:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      CFG_DDR_SGMII_PHY->DPC_BITS.DPC_BITS        =\
2620:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****              LIBERO_SETTING_DPC_BITS_OFF_MODE;
2621:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
2622:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     /*
2623:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      * Toggle decoder here
2624:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      *  bit 0 == PERIPH   soft reset, auto cleared
2625:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      */
2626:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      CFG_DDR_SGMII_PHY->SOFT_RESET_DECODER_DRIVER.SOFT_RESET_DECODER_DRIVER= 1U;
2627:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      CFG_DDR_SGMII_PHY->SOFT_RESET_DECODER_ODT.SOFT_RESET_DECODER_ODT      = 1U;
2628:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      CFG_DDR_SGMII_PHY->SOFT_RESET_DECODER_IO.SOFT_RESET_DECODER_IO        = 1U;
2629:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
2630:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      /*
2631:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * set ibuff mode to 7 in off mode
2632:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       *
2633:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       */
2634:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      CFG_DDR_SGMII_PHY->rpc95.rpc95 = 0x07;     /* addcmd I/O*/
2635:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      CFG_DDR_SGMII_PHY->rpc96.rpc96 = 0x07;     /* clk */
2636:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      CFG_DDR_SGMII_PHY->rpc97.rpc97 = 0x07;     /* dq */
2637:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      CFG_DDR_SGMII_PHY->rpc98.rpc98 = 0x07;     /* dqs */
2638:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
2639:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      /*
2640:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * Default  WPU, modify If user wants Weak Pull Up
2641:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       */
2642:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      /*
2643:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * UNUSED_SPACE0
2644:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       *     bits 15:14 connect to ibufmx DQ/DQS/DM
2645:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       *     bits 13:12 connect to ibufmx CA/CK
2646:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       *    todo: Do we need to add Pu/PD option for off mode to Libero setting?
2647:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       */
2648:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      CFG_DDR_SGMII_PHY->UNUSED_SPACE0[0] = 0x0000U;
2649:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
2650:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     /*
2651:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      *  REG_POWERDOWN_B on PLL turn-off, in case was turned on.
2652:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      */
2653:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     ddr_pll_config_scb_turn_off();
2654:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     return;
2655:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** }
2656:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
2657:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
2658:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /***************************************************************************//**
2659:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  * Number of tests which write and read from DDR
2660:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  * Tests data path through the cache and through AXI4 switch.
2661:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  */
2662:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** #ifdef DDR_SANITY_CHECKS_EN
2663:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** static uint8_t memory_tests(void)
2664:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** {
2665:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     uint64_t shift_walking_one = 4U;
2666:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     uint64_t start_address = 0x0000000000000000U;
2667:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     uint8_t error = 0U;
2668:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     /*
2669:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      * Verify seg1 reg 2, datapath through AXI4 switch
2670:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      */
2671:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     while(shift_walking_one <= 28U) /* 28 => 1G, as 2**28 == 256K and this is
2672:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                                       mult by (4 lanes) */
2673:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     {
2674:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         start_address = (uint64_t)(BASE_ADDRESS_NON_CACHED_32_DDR + (0x1U<<shift_walking_one));
2675:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         error = rw_sanity_chk((uint64_t *)start_address , (uint32_t)0x5U);
2676:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
2677:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         if(error)
2678:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         {
2679:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             ddr_error_count++;
2680:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         }
2681:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         shift_walking_one++;
2682:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     }
2683:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     /*
2684:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      * Verify seg1 reg 3, datapath through AXI4 switch
2685:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      */
2686:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     shift_walking_one = 4U;
2687:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     while(shift_walking_one <= 28U) /* 28 => 1G */
2688:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     {
