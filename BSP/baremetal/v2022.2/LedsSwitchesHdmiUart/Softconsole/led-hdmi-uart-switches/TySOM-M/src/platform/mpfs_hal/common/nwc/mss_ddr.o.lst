3553:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *  set error mask registers MT_ERROR_MASK_* to mask out
3554:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *    all error bits but the ones for the current DQ lane
3555:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *    WHILE timeout counter is less than a threshold
3556:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *        perform memory test by writing MT_EN or MT_EN_SINGLE
3557:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *        wait for memory test completion by polling MT_DONE_ACK
3558:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *        read back memory test error status from MT_ERROR_STS
3559:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *       IF no error detected
3560:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *          exit loop
3561:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *        ELSE
3562:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *          increment write calibration offset for current DQ lane
3563:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *          by writing EXPERT_WRCALIB
3564:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *    ENDWHILE
3565:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *  ENDFOR
3566:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     */
