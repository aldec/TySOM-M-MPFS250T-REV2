 272:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             return_status = 0U;
 273:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             break;
 274:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
 275:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         case DDR_STATE_TRAINING:
 276:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             /*
 277:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****              * We stay in this state until finished training/fail training
