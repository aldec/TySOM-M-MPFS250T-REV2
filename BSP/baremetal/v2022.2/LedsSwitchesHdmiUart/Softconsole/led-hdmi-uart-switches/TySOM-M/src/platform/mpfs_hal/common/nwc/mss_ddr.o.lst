3412:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         /* Read twice, two different patterns will be used */
3413:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         result = MTC_test(1U<<laneToTest, start_address, size);
