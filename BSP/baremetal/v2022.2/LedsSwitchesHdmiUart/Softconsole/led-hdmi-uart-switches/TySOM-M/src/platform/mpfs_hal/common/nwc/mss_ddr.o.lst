2763:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  * writes and verifies reads back from DDR
2764:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  * Uses values defined in the test_string[]
2765:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  * @param address
