3425:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         }
3426:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         else if(calib_data.mem_vref.upper != MEM_VREF_INVALID)
