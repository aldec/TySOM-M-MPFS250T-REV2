3250:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     /*
3251:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     * training carried out here- sweeping write calibration offset from 0 to F
3252:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     * Explanation: A register, expert_wrcalib, is described in MSS DDR TIP
3253:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     * Register Map [1], and its purpose is to delay--by X number of memory
3254:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     * clock cycles--the write data, write data mask, and write output enable
3255:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     * with the respect to the address and command for each lane.
3256:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     */
3257:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     calib_data.fpga_vref.vref_result = 0U;
3258:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     calib_data.fpga_vref.lower = VREF_INVALID;
3259:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     calib_data.fpga_vref.upper = VREF_INVALID;
3260:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     calib_data.fpga_vref.status_lower = 0x00U;
3261:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     calib_data.fpga_vref.status_upper = 0x00U;
3262:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     mask = 0xFU;        /* todo: obtain data width from user parameters */
3263:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     uint32_t count = 0U;
3264:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     /* each bit .25% of VDD ?? */
3265:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     for (vRef=(0x1U<<4U);vRef<(0x1fU<<4U);vRef=vRef+(0x1U<<4U))
3266:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     {
3267:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         /*
3268:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             CFG_DDR_SGMII_PHY->DPC_BITS.DPC_BITS =\
3269:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                           (CFG_DDR_SGMII_PHY->DPC_BITS.DPC_BITS & (~(0x1U<<10U)));
3270:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             CFG_DDR_SGMII_PHY->DPC_BITS.DPC_BITS =\
3271:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                   (CFG_DDR_SGMII_PHY->DPC_BITS.DPC_BITS & (~(0x1fU<<4U))) | vRef;
3272:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         */
3273:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         /* need to set via the SCB, otherwise reset required. So lines below
3274:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****          * rather than above used */
3275:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
3276:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         IOSCB_BANKCONT_DDR->dpc_bits = (IOSCB_BANKCONT_DDR->dpc_bits &\
3277:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                 (~(0x1U<<10U)));
3278:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         IOSCB_BANKCONT_DDR->dpc_bits = (IOSCB_BANKCONT_DDR->dpc_bits &\
3279:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                 (~(0x1fU<<4U))) | vRef;
3280:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
3281:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
3282:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         /* read one to flush MTC -  this is required */
3283:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         result = MTC_test(1U<<laneToTest, start_address, size);
3284:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         /* Read twice, two different patterns will be used */
3285:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         result = MTC_test(1U<<laneToTest, start_address, size);
3286:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         result |= MTC_test(1U<<laneToTest, start_address, size);
3287:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         if((result == 0U)&&(calib_data.fpga_vref.lower == VREF_INVALID))
3288:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         {
