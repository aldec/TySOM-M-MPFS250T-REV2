2786:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
2787:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         value = *DDR_word_ptr;
2788:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
2789:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         if( value != test_string[i & 0xfU])
2790:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         {
2791:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             value = *DDR_word_ptr;
2792:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             if( value != test_string[i & 0xfU])
2793:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             {
2794:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                 ddr_error_count++;
2795:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                 error = 1;
2796:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             }
2797:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         }
2798:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         ++i;
