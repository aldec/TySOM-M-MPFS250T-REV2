 116:../src/platform/mpfs_hal/common/mss_peripherals.c **** /**
 117:../src/platform/mpfs_hal/common/mss_peripherals.c ****  * Turn on/off mss peripheral as required
 118:../src/platform/mpfs_hal/common/mss_peripherals.c ****  * @param peripheral_mask
 119:../src/platform/mpfs_hal/common/mss_peripherals.c ****  * @param req_state
 120:../src/platform/mpfs_hal/common/mss_peripherals.c ****  */
 121:../src/platform/mpfs_hal/common/mss_peripherals.c **** static inline void peripheral_on_off(uint32_t peripheral_mask , PERIPH_RESET_STATE req_state)
 122:../src/platform/mpfs_hal/common/mss_peripherals.c **** {
 123:../src/platform/mpfs_hal/common/mss_peripherals.c ****     if (req_state == PERIPHERAL_OFF)
 124:../src/platform/mpfs_hal/common/mss_peripherals.c ****     {
 125:../src/platform/mpfs_hal/common/mss_peripherals.c ****         /* Turn off clock */
 126:../src/platform/mpfs_hal/common/mss_peripherals.c ****         SYSREG->SUBBLK_CLOCK_CR &= (uint32_t)~(peripheral_mask);
 127:../src/platform/mpfs_hal/common/mss_peripherals.c ****         /* Hold in reset */
 128:../src/platform/mpfs_hal/common/mss_peripherals.c ****         SYSREG->SOFT_RESET_CR   |= (uint32_t)(peripheral_mask);
 129:../src/platform/mpfs_hal/common/mss_peripherals.c ****     }
 130:../src/platform/mpfs_hal/common/mss_peripherals.c ****     else
 131:../src/platform/mpfs_hal/common/mss_peripherals.c ****     {
 132:../src/platform/mpfs_hal/common/mss_peripherals.c ****         /* Turn on clock */
 133:../src/platform/mpfs_hal/common/mss_peripherals.c ****         SYSREG->SUBBLK_CLOCK_CR |= (peripheral_mask);
 134:../src/platform/mpfs_hal/common/mss_peripherals.c ****         /* Remove soft reset */
 135:../src/platform/mpfs_hal/common/mss_peripherals.c ****         SYSREG->SOFT_RESET_CR   &= (uint32_t)~(peripheral_mask);
 136:../src/platform/mpfs_hal/common/mss_peripherals.c ****     }
 137:../src/platform/mpfs_hal/common/mss_peripherals.c **** }
