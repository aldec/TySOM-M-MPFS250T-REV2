 596              	 /*****************************************************************************/
 597              	
 598              	.enable_sw_int:
 599 03e8 13068000 	    li a2, MIP_MSIP
 600 03ec 73104630 	    csrw mie, a2            # Set MSIE bit to receive IPI
 601 03f0 13068000 	    li a2,  MSTATUS_MIE
 602 03f4 73200630 	    csrs mstatus, a2        # enable interrupts
 603              	    /* flush the instruction cache */
 604 03f8 0F100000 	    fence.i
 605 03fc 67800000 	    ret
