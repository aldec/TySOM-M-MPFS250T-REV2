  31              	#ifndef RISCV_BITS_H
  32              	#define RISCV_BITS_H
  33              	
  34              	#ifdef __cplusplus
  35              	extern "C" {
  36              	#endif
  37              	
  38              	#define likely(x) __builtin_expect((x), 1)
  39              	#define unlikely(x) __builtin_expect((x), 0)
  40              	
  41              	#ifndef ROUNDUP
  42              	#    define ROUNDUP(a, b) ((((a)-1)/(b)+1)*(b))
  43              	#endif
  44              	
  45              	#ifndef ROUNDDOWN
  46              	#    define ROUNDDOWN(a, b) ((a)/(b)*(b))
  47              	#endif
  48              	
  49              	#define MAX(a, b) ((a) > (b) ? (a) : (b))
  50              	#define MIN(a, b) ((a) < (b) ? (a) : (b))
  51              	#define CLAMP(a, lo, hi) MIN(MAX(a, lo), hi)
  52              	
  53              	#define EXTRACT_FIELD(val, which) (((val) & (which)) / ((which) & ~((which)-1)))
  54              	#define INSERT_FIELD(val, which, fieldval) (((val) & ~(which)) | ((fieldval) * ((which) & ~((which)
  55              	
  56              	#define STR(x) XSTR(x)
  57              	#define XSTR(x) #x
  58              	
  59              	#if __riscv_xlen == 64
  60              	# define SLL32    sllw
  61              	# define STORE    sd
  62              	# define LOAD     ld
  63              	# define LWU      lwu
  64              	# define LOG_REGBYTES 3
  65              	#else
  66              	# define SLL32    sll
  67              	# define STORE    sw
  68              	# define LOAD     lw
  69              	# define LWU      lw
  70              	# define LOG_REGBYTES 2
  71              	#endif
  72              	#define REGBYTES (1 << LOG_REGBYTES)
