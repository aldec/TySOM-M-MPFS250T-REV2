 482              	/******************************************************************************/
 483              	/******************************interrupt handeling below here******************/
 484              	/******************************************************************************/
 485              	
 486              	trap_vector:
 487              	#if defined USING_FREERTOS
 488              	    addi    sp, sp, -REGBYTES /* Save t0 for now */
 489              	    STORE   t0, 0x0(sp)
 490              	    csrr  t0, mcause
 491              	    bge   t0,x0,.Le51_other  /* Not an interrupt... */
 492              	    slli  t0,t0,1
 493              	    srli  t0,t0,1
 494              	    addi  t0,t0,-7
 495              	    bne   t0,x0,.Le51_other /* Not Timer interrupt... */
 496              	    /* Interrupt is timer interrupt so let FreeRTOS handle it */
 497              	    LOAD    t0, 0x0(sp)     # Restore t0 for proper context save by FreeRTOS
 498              	    addi    sp, sp, REGBYTES
 499              	    j       TIMER_CMP_INT
 500              	    mret
 501              	
 502              	.Le51_other:                # Re-enter mainline here if not timer interrupt
 503              	    LOAD    t0, 0x0(sp)       # Restore t0 for proper context save by HAL
 504              	    addi    sp, sp, REGBYTES
 505              	#endif
 506              	    # The mscratch register is an XLEN-bit read/write register dedicated for use by machine mode.
 507              	    # Typically, it is used to hold a pointer to a machine-mode hart-local context space and swappe
 508              	    # with a user register upon entry to an M-mode trap handler.
 509              	    # In this implementation, we are noty using HLS
 510              	    # csrrw sp, mscratch, sp                    #copy sp to mscratch, and mscrath to sp
 511              	
 512 02d4 130101F0 	    addi sp, sp, -INTEGER_CONTEXT_SIZE     # moves sp down stack to make I
 513              	                                           # INTEGER_CONTEXT_SIZE area
 514              	    # Preserve the registers.
 515 02d8 23382100 	    STORE sp, 2*REGBYTES(sp)               # sp
 516 02dc 2338A104 	    STORE a0, 10*REGBYTES(sp)              # save a0,a1 in the created CONTEXT
 517 02e0 233CB104 	    STORE a1, 11*REGBYTES(sp)
 518 02e4 23341100 	    STORE ra, 1*REGBYTES(sp)
 519 02e8 233C3100 	    STORE gp, 3*REGBYTES(sp)
 520 02ec 23304102 	    STORE tp, 4*REGBYTES(sp)
 521 02f0 23345102 	    STORE t0, 5*REGBYTES(sp)
 522 02f4 23386102 	    STORE t1, 6*REGBYTES(sp)
 523 02f8 233C7102 	    STORE t2, 7*REGBYTES(sp)
 524 02fc 23308104 	    STORE s0, 8*REGBYTES(sp)
 525 0300 23349104 	    STORE s1, 9*REGBYTES(sp)
 526 0304 2330C106 	    STORE a2,12*REGBYTES(sp)
 527 0308 2334D106 	    STORE a3,13*REGBYTES(sp)
 528 030c 2338E106 	    STORE a4,14*REGBYTES(sp)
 529 0310 233CF106 	    STORE a5,15*REGBYTES(sp)
 530 0314 23300109 	    STORE a6,16*REGBYTES(sp)
 531 0318 23341109 	    STORE a7,17*REGBYTES(sp)
 532 031c 23382109 	    STORE s2,18*REGBYTES(sp)
 533 0320 233C3109 	    STORE s3,19*REGBYTES(sp)
 534 0324 2330410B 	    STORE s4,20*REGBYTES(sp)
 535 0328 2334510B 	    STORE s5,21*REGBYTES(sp)
 536 032c 2338610B 	    STORE s6,22*REGBYTES(sp)
 537 0330 233C710B 	    STORE s7,23*REGBYTES(sp)
 538 0334 2330810D 	    STORE s8,24*REGBYTES(sp)
 539 0338 2334910D 	    STORE s9,25*REGBYTES(sp)
 540 033c 2338A10D 	    STORE s10,26*REGBYTES(sp)
 541 0340 233CB10D 	    STORE s11,27*REGBYTES(sp)
 542 0344 2330C10F 	    STORE t3,28*REGBYTES(sp)
 543 0348 2334D10F 	    STORE t4,29*REGBYTES(sp)
 544 034c 2338E10F 	    STORE t5,30*REGBYTES(sp)
 545 0350 233CF10F 	    STORE t6,31*REGBYTES(sp)
 546              	    # Invoke the handler.
 547 0354 13050100 	    mv a0, sp                          # a0 <- regs
 548              	    # Please note: mtval is the newer name for register mbadaddr
 549              	    # If you get a compile failure here, use the newer name
 550              	    # At this point (2019), both are supported in latest compiler
 551              	    # older compiler versions only support mbadaddr, so going with this.
 552              	    # See: https://github.com/riscv/riscv-gcc/issues/133
 553 0358 F3253034 	    csrr a1, mbadaddr                 # useful for anaysis when things go wrong
 554 035c 73261034 	    csrr a2, mepc
 555 0360 EFF01FCA 	    jal trap_from_machine_mode
 556              	
 557              	restore_regs:
 558              	    # Restore all of the registers.
 559 0364 83308100 	    LOAD ra, 1*REGBYTES(sp)
 560 0368 83318101 	    LOAD gp, 3*REGBYTES(sp)
 561 036c 03320102 	    LOAD tp, 4*REGBYTES(sp)
 562 0370 83328102 	    LOAD t0, 5*REGBYTES(sp)
 563 0374 03330103 	    LOAD t1, 6*REGBYTES(sp)
 564 0378 83338103 	    LOAD t2, 7*REGBYTES(sp)
 565 037c 03340104 	    LOAD s0, 8*REGBYTES(sp)
 566 0380 83348104 	    LOAD s1, 9*REGBYTES(sp)
 567 0384 03350105 	    LOAD a0,10*REGBYTES(sp)
 568 0388 83358105 	    LOAD a1,11*REGBYTES(sp)
 569 038c 03360106 	    LOAD a2,12*REGBYTES(sp)
 570 0390 83368106 	    LOAD a3,13*REGBYTES(sp)
 571 0394 03370107 	    LOAD a4,14*REGBYTES(sp)
 572 0398 83378107 	    LOAD a5,15*REGBYTES(sp)
 573 039c 03380108 	    LOAD a6,16*REGBYTES(sp)
 574 03a0 83388108 	    LOAD a7,17*REGBYTES(sp)
 575 03a4 03390109 	    LOAD s2,18*REGBYTES(sp)
 576 03a8 83398109 	    LOAD s3,19*REGBYTES(sp)
 577 03ac 033A010A 	    LOAD s4,20*REGBYTES(sp)
 578 03b0 833A810A 	    LOAD s5,21*REGBYTES(sp)
 579 03b4 033B010B 	    LOAD s6,22*REGBYTES(sp)
 580 03b8 833B810B 	    LOAD s7,23*REGBYTES(sp)
 581 03bc 033C010C 	    LOAD s8,24*REGBYTES(sp)
 582 03c0 833C810C 	    LOAD s9,25*REGBYTES(sp)
 583 03c4 033D010D 	    LOAD s10,26*REGBYTES(sp)
 584 03c8 833D810D 	    LOAD s11,27*REGBYTES(sp)
 585 03cc 033E010E 	    LOAD t3,28*REGBYTES(sp)
 586 03d0 833E810E 	    LOAD t4,29*REGBYTES(sp)
 587 03d4 033F010F 	    LOAD t5,30*REGBYTES(sp)
 588 03d8 833F810F 	    LOAD t6,31*REGBYTES(sp)
 589 03dc 03310101 	    LOAD sp, 2*REGBYTES(sp)
 590 03e0 13010110 	    addi sp, sp, +INTEGER_CONTEXT_SIZE  # moves sp up stack to reclaim
 591              	                                        # INTEGER_CONTEXT_SIZE area
 592 03e4 73002030 	    mret
