 607              	 /***********************************************************************************
 608              	 *
 609              	 * The following init_memory() symbol overrides the weak symbol in the HAL and does
 610              	 * a safe copy of RW data and clears zero-init memory
 611              	 *
 612              	 */
 613              	    // zero_section helper function:
 614              	    //       a0 = exec_start_addr
 615              	    //       a1 = exec_end_addr
 616              	    //
 617              	    .globl  zero_section
 619              	zero_section:
 620 0400 6358B500 	    bge a0, a1, .zero_section_done
 621 0404 23300500 	    sd  zero, (a0)
 622 0408 13058500 	    addi    a0, a0, 8
 623 040c 6FF05FFF 	    j   zero_section
 624              	.zero_section_done:
 625 0410 67800000 	    ret
 626              	
 627              	    // zero_section helper function:
 628              	    //       a0 = exec_start_addr
 629              	    //       a1 = exec_end_addr
 630              	    //       a2 = start count
 631              	    //
 632              	    .globl  count_section
 634              	count_section:
 635 0414 630AB500 	    beq a0, a1, .count_section_done
 636 0418 2330C500 	    sd  a2, (a0)
 637 041c 13058500 	    addi    a0, a0, 8
 638 0420 13068600 	    addi    a2, a2, 8
 639 0424 6FF01FFF 	    j   count_section
 640              	.count_section_done:
 641 0428 67800000 	    ret
 642              	
 643              	    // copy_section helper function:
 644              	    //  a0 = load_addr
 645              	    //  a1 = exec_start_addr
 646              	    //  a2 = exec_end_addr
 647              	    .globl  copy_section
 649              	copy_section:
 650 042c 638EA500 	    beq a1, a0, .copy_section_done // if load_addr == exec_start_addr, goto copy_section_done
 651              	.check_if_copy_section_done:
 652 0430 638CC500 	    beq a1, a2, .copy_section_done // if offset != length, goto keep_copying
 653              	.keep_copying:
 654 0434 83360500 	    ld  a3, 0(a0)                  // val = *load_addr
 655 0438 23B0D500 	    sd  a3, 0(a1)                  // *exec_start_addr = val;
 656 043c 13058500 	    addi    a0, a0, 8              // load_addr = load_addr + 8
 657 0440 93858500 	    addi    a1, a1, 8              // exec_start_addr = exec_start_addr + 8
 658 0444 6FF0DFFE 	    j   .check_if_copy_section_done
 659              	.copy_section_done:
 660 0448 67800000 	    ret
 661              	
 662              	
 663              	/*******************************************************************************
 664              	 *
 665              	 * The following copy_switch_code() symbol overrides the weak symbol in the HAL and does
 666              	 * a safe copy of HW config data
 667              	 */
 668              	    .globl  copy_switch_code
 670              	copy_switch_code:
 671 044c 97070000 	    la      a5, __sc_start           // a5 = __sc_start
 671      93870700 
 672 0454 17070000 	    la      a4, __sc_load            // a4 = __sc_load
 672      13070700 
 673 045c 6382E702 	    beq a5,a4,.copy_switch_code_done // if a5 == a4, goto copy_switch_code_done
 674 0460 97060000 	    la      a3, __sc_end             // a3 = __sc_end
 674      93860600 
 675 0468 638CD700 	    beq a5,a3,.copy_switch_code_done // if a5 == a3, goto copy_switch_code_done
 676              	.copy_switch_code_loop:
 677 046c 03260700 	    lw  a2,0(a4)                     // a2 = *a4
 678 0470 23A0C700 	    sw  a2,0(a5)                     // *a5 = a2
 679 0474 93874700 	    addi    a5,a5,4                  // a5+=4
 680 0478 13074700 	    addi    a4,a4,4                  // a4+=4
 681              	
 682 047c E3E8D7FE 	    bltu    a5,a3,.copy_switch_code_loop // if a5 < a3, goto copy_switch_code_loop
 683              	.copy_switch_code_done:
 684 0480 67800000 	    ret
 685              	
 686              	/*******************************************************************************
 687              	 *
 688              	 */
 689              	#define START__OF_LIM 0x08000000
 690              	#define END__OF_LIM   0x08200000
 691              	#define START__OF_DTM 0x01000000
 692              	#define END__OF_DTM   0x01002000
 693              	#define START_OF_SCRATCH   0x0A000000
 694              	
 695              	.clear_scratchpad:
 696              	    // Clear the scratchpad
 697              	    //
 698              	    // a0 = end of scratchpad addr passed from caller
 699              	    //
 700              	    // Note: This must be called post calling config_l2_cache()
 701              	    //
 702 0484 3707000A 	    la  a4, START_OF_SCRATCH    # start of l2 scratchpad
 703 0488 93070500 	    mv  a5, a0                  # end of l2 scratchpad
 704              	    // common loop used to clear memory
 705 048c 6F008002 	    j   1f
 706              	.clear_l2lim:
 707              	    // Clear the LIM
 708              	    //
 709              	    // On reset, the first 15 ways are L2 and the last way is cache
 710              	    // We can initialize all, as cache write through to DDR is blocked
 711              	    // until DDR in initialized, so will have no effect other than clear ECC
 712              	    //
 713              	    // NOTE: we need to check if we are debugging from LIM,if so do not
 714              	    // initialize.
 715              	    //
 716 0490 17060000 	    la a2, _start
 716      13060600 
 717 0498 37070008 	    la  a4, 0x08000000          # start of LIM address
 718 049c 3376E600 	    and a2, a2, a4
 719 04a0 63100602 	    bnez a2, .done_clear
 720 04a4 B7072008 	    la  a5, 0x08200000          # end of LIM address
 721 04a8 6F00C000 	    j   1f
 722              	.clear_dtim:
 723              	    //
 724              	    // Clear the E51 DTIM to prevent any ECC memory errors on initial access
 725              	    //
 726 04ac 37070001 	    la  a4, 0x01000000          # DTIM start
 727 04b0 B7270001 	    la  a5, 0x01002000          # DTIM end
 728              	1:
 729              	    // common loop used by both .clear_l2lim and .clear_dtim
 730 04b4 23300700 	    sd   x0, 0(a4)
 731 04b8 13078700 	    add a4, a4, __SIZEOF_POINTER__
 732 04bc E34CF7FE 	    blt a4, a5, 1b
 733              	.done_clear:
 734 04c0 67800000 	    ret
 735              	
 736              	/*******************************************************************************
 737              	 *
 738              	 */
 739              	    .equ    L2_ZERO_DEVICE_ADDR, 0x0A000000
 740              	    .equ    L2_CCACHE_ADDR, 0x02010000
 741              	    .equ    FLUSH64_OFFSET, 0x200
 742              	
 743              	    //
 744              	    // We want to flush anything that may be inadvertently cached
 745              	    // by the actions of G5C at startup...
 746              	    //
 747              	    // The cache block is 64-bytes wide, and there are 4 banks * 512 sets * 16
 748              	    // ways.
 749              	    // From power on, only a single way is enabled as cache (the remaining
 750              	    // 15 are LIM), but this function is parameterisable (number of ways is
 751              	    // passed via a0)...
 752              	    //
 753              	    // First, load the cache with "known" addresses by walking up L2 scratch
 754              	    // with a 64-byte stride. We need to read (4 banks * 512 sets) to fill
 755              	    // a single way.
 756              	    //
 757              	.flush_early_caching:
 758              	                        // a0 = num_ways
 759 04c4 13151501 	    slli    a0, a0, 17  // a0' = a0 * (4 * 512 * 64)
 760 04c8 B707000A 	    li  a5, L2_ZERO_DEVICE_ADDR
 761 04cc 3305F500 	    add a0, a0, a5      // a0''  = a0' + (4 * 512 * 64 * a0)
 762              	                        //  = 0x0A000000 + (4 * 512 * 64 * num_ways)
 763 04d0 6302F502 	    beq a0, a5, .early_exit
 764              	
 765              	.preload_cache_with_known_addrs:
 766 04d4 83B60700 	    ld  a3, 0(a5)
 767 04d8 93870704 	    addi    a5, a5, 64
 768 04dc E39CA7FE 	    bne a5, a0, .preload_cache_with_known_addrs
 769              	
 770              	    //
 771              	    // Now that the cache is filled with known addresses, we can simply flush each
 772              	    // known address to end up with an empty cache...
 773              	    //
 774 04e0 B707000A 	    li  a5, L2_ZERO_DEVICE_ADDR
 775 04e4 B7060102 	    li  a3, L2_CCACHE_ADDR
 776              	.flush_known_addrs_from_cache:
 777 04e8 23B0F620 	    sd  a5, FLUSH64_OFFSET(a3)      // write address to 0x02010200 (FLUSH64)
 778 04ec 93870704 	    addi    a5, a5, 64
 779 04f0 E39CA7FE 	    bne a5, a0, .flush_known_addrs_from_cache
 780              	
 781              	.early_exit:
 782 04f4 67800000 	    ret
 783              	
 784              	/*
 785              	 * record_ecc_error_counts on reset
 786              	 * These are non-zero in the coreplex.
 787              	 * Can be checked later on to see if values have changed
 788              	 *      a0 = mECCDataFailCount save address
 789              	        a1 = mECCDataCorrectionCount save address
 790              	        a2 = mECCDirFixCount save address
 791              	 */
 792              	.record_ecc_error_counts:
 793              	    # Store initial ECC errors
 794              	    #define mECCDataFailCount               0x02010168U
 795 04f8 B7070102 	    la  a5, mECCDataFailCount
 795      9B878716 
 796 0500 13070500 	    mv  a4, a0// eg. Use stat of DTIM in not used for anything else  0x01000100
 797 0504 83A30700 	    lw  t2,0(a5)
 798 0508 23207700 	    sw  t2,0(a4)
 799              	    #define mECCDataCorrectionCount         0x02010148U
 800 050c B7070102 	    la  a5, mECCDataCorrectionCount
 800      9B878714 
 801 0514 13870500 	    mv  a4, a1// eg. Use stat of DTIM in not used for anything else 0x01000110
 802 0518 83A30700 	    lw  t2,0(a5)
 803 051c 23207700 	    sw  t2,0(a4)
 804              	    #define mECCDirFixCount                 0x02010108u
 805 0520 B7070102 	    la  a5, mECCDirFixCount
 805      9B878710 
 806 0528 13070600 	    mv  a4, a2// eg. Use stat of DTIM in not used for anything else 0x01000120
 807 052c 83A30700 	    lw  t2,0(a5)
 808 0530 23207700 	    sw  t2,0(a4)
 809 0534 67800000 	    ret
 810              	
