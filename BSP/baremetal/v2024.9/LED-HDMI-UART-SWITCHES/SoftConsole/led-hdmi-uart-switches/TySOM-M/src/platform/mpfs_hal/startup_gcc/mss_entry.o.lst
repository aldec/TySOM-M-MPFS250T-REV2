 191              	// page table entry (PTE) fields
 192              	#define PTE_V     0x001 // Valid
 193              	#define PTE_R     0x002 // Read
 194              	#define PTE_W     0x004 // Write
 195              	#define PTE_X     0x008 // Execute
 196              	#define PTE_U     0x010 // User
 197              	#define PTE_G     0x020 // Global
 198              	#define PTE_A     0x040 // Accessed
 199              	#define PTE_D     0x080 // Dirty
 200              	#define PTE_SOFT  0x300 // Reserved for Software
 201              	
 202              	#define PTE_PPN_SHIFT 10
 203              	
 204              	#define PTE_TABLE(PTE) (((PTE) & (PTE_V | PTE_R | PTE_W | PTE_X)) == PTE_V)
