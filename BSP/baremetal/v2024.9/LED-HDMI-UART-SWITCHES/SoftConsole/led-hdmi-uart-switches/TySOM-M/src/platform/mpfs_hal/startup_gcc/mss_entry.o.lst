 284              	#else   /* IMAGE_LOADED_BY_BOOTLOADER == 1 */
 285              	/*******************************************************************************
 286              	 *The program has been loaded by a bootloader
 287              	 * a0 - contains the hart ID
 288              	 * a1 - contains pointer to bootloader -Hart Local Storage, for this hart.
 289              	 */
 290              	_start_non_bootloader_amp_image:
 291              	    /* Setup trap handler */
 292              	    la a4, trap_vector
 293              	    csrw mtvec, a4          # initalise machine trap vector address
 294              	    /* Make sure that mtvec is updated before continuing */
 295              	    1:
 296              	    csrr    a5, mtvec
 297              	    bne a4, a5, 1b
 298              	    /* assume ints in init state */
 299              	    /* assume PMP's set as required */
 300              	    # enable FPU and accelerator if present, setting ignored on E51
 301              	    li t0, MSTATUS_FS | MSTATUS_XS
 302              	    csrs mstatus, t0
 303              	
 304              	    # Init floating point control register to zero
 305              	    # skip if e51
 306              	    csrr a0, mhartid
 307              	    beqz a0, .no_float
 308              	#ifdef __riscv_flen
 309              	    fscsr x0
 310              	#endif
 311              	.no_float:
 312              	
 313              	     # make sure XLEN agrees with compilation choice, if not will loop here
 314              	.LxlenCheck:
 315              	    csrr t0, misa
 316              	#if __riscv_xlen == 64
 317              	    bltz t0, .LxlenPass
 318              	#else
 319              	    bgez t0, .LxlenPass
 320              	#endif
 321              	    j .LxlenCheck
 322              	.LxlenPass:
 323              	
 324              	    # initialize global pointer, global data
 325              	    # The __global_pointer is allocated in the linker script. It points to a
 326              	    # location 2k after sdata start as the offsets used in the gp are +/- 2k
 327              	    # See https://www.sifive.com/blog/2017/08/28/all-aboard-part-3-linker-relaxation-in-riscv-toolc
 328              	    # see: http://www.rowleydownload.co.uk/arm/documentation/gnu/as/RISC_002dV_002dDirectives.html
 329              	    .option push
 330              	    .option norelax
 331              	    la gp, __global_pointer$
 332              	    .option pop
 333              	
 334              	    # get core id
 335              	    csrr a0, mhartid
 336              	    li a1,  0
 337              	    beq a0, a1, .hart0
 338              	    li a1,  1
 339              	    beq a0, a1, .hart1
 340              	    li a1,  2
 341              	    beq a0, a1, .hart2
 342              	    li a1,  3
 343              	    beq a0, a1, .hart3
 344              	    li a1,  4
 345              	    beq a0, a1, .hart4
 346              	
 347              	.hart0:
 348              	    la a4, __stack_bottom_h0$  # keep bottom of stack in a5 so we can init later
 349              	    la sp, __stack_top_h0$
 350              	    j .continue
 351              	.hart1:
 352              	    la a4, __stack_bottom_h1$  # keep bottom of stack in a5 so we can init later
 353              	    la sp, __stack_top_h1$
 354              	    j .continue
 355              	.hart2:
 356              	    la a4, __stack_bottom_h2$  # keep bottom of stack in a5 so we can init later
 357              	    la sp, __stack_top_h2$
 358              	    j .continue
 359              	.hart3:
 360              	    la a4, __stack_bottom_h3$  # keep bottom of stack in a5 so we can init later
 361              	    la sp, __stack_top_h3$
 362              	    j .continue
 363              	.hart4:
 364              	    la a4, __stack_bottom_h4$  # keep bottom of stack in a5 so we can init later
 365              	    la sp, __stack_top_h4$
 366              	
 367              	.continue:
 368              	    # clear HLS and stack
 369              	    mv  a5, sp
 370              	.init_stack:
 371              	    #csrw mepc, zero
 372              	    STORE x0, 0(a4)
 373              	    add a4, a4, __SIZEOF_POINTER__
 374              	    blt a4, a5, .init_stack
 375              	    # Allocate some space at top of stack for the HLS
 376              	    addi sp, sp, -HLS_DEBUG_AREA_SIZE
 377              	    # HLS grows up from new top of stack
 378              	    mv tp, sp
 379              	    # get core id
 380              	    csrr a0, mhartid
 381              	    li a1, MPFS_HAL_FIRST_HART
 382              	    bne a0, a1, .LOtherHartstoWFI
 383              	    # clear the common heap
 384              	    la  a4, __heap_start
 385              	    la  a5, __heap_end
 386              	.init_heap:
 387              	    #csrw mepc, zero
 388              	    STORE x0, 0(a4)
 389              	    add a4, a4, __SIZEOF_POINTER__
 390              	    blt a4, a5, .init_heap
 391              	    # now core MPFS_HAL_FIRST_HART jumps to main_first_hart
 392              	.main_hart:
 393              	    # pass HLS address
 394              	    mv  a0, tp
 395              	    j main_first_hart_app
 396              	.LoopForeverMain:
 397              	    #in case of return, loop forever. nop's added so can be seen in debugger
 398              	    nop
 399              	    nop
 400              	    j .LoopForeverMain
 401              	
 402              	.LOtherHartstoWFI:
 403              	    li a2,  MSTATUS_MIE
 404              	    csrc mstatus, a2       # clear interrupt enable bit
 405              	    csrw mie, zero
 406              	    csrw mip, zero
 407              	    li a2, MIP_MSIP
 408              	    csrw mie, a2           # Set MSIE bit to receive IPI. This needs to be
 409              	                           # enabled- otherwise stays in wfi.
 410              	                           # Other interrupts appera to bring out of wfi,even if
 411              	                           # not enabled.
 412              	    #
 413              	    # Wait here until main hart is up and running
 414              	    #
 415              	    # get core id
 416              	    la a2, MPFS_HAL_FIRST_HART
 417              	    li a3,  0
 418              	    beq a3, a2, .main_hart0
 419              	    li a3,  1
 420              	    beq a3, a2, .main_hart1
 421              	    li a3,  2
 422              	    beq a3, a2, .main_hart2
 423              	    li a3,  3
 424              	    beq a3, a2, .main_hart3
 425              	    li a3,  4
 426              	    beq a3, a2, .main_hart4
 427              	
 428              	.main_hart0:
 429              	    la a4, (__stack_top_h0$ - HLS_DEBUG_AREA_SIZE)
 430              	    j  1f
 431              	.main_hart1:
 432              	    la a4, (__stack_top_h1$ - HLS_DEBUG_AREA_SIZE)
 433              	    j  1f
 434              	.main_hart2:
 435              	    la a4, (__stack_top_h2$ - HLS_DEBUG_AREA_SIZE)
 436              	    j  1f
 437              	.main_hart3:
 438              	    la a4, (__stack_top_h3$ - HLS_DEBUG_AREA_SIZE)
 439              	    j  1f
 440              	.main_hart4:
 441              	    la a4, (__stack_top_h4$ - HLS_DEBUG_AREA_SIZE)
 442              	1:
 443              	    li a3, HLS_MAIN_HART_STARTED
 444              	.wait_main_hart:
 445              	    LWU a2, 0(a4)
 446              	    bne a3, a2, .wait_main_hart
 447              	    # Flag we are here to the main hart
 448              	    li a1, HLS_OTHER_HART_IN_WFI
 449              	    sw a1, 0(tp)
 450              	    /* flush the instruction cache */
 451              	    fence.i
 452              	.LwaitOtherHart:
 453              	    # We assume wfi instruction will be run before main hart attampts to take
 454              	    # out of wfi
 455              	    wfi
 456              	    # Only start if MIP_MSIP is set - the wfi will ensure this, but adding
 457              	    # breakpoints in the debugger (halt)
 458              	    # will wakeup wfi, so the following code will make sure we remain here until
 459              	    # we get a software interrupt
 460              	    csrr a2, mip
 461              	    andi a2, a2, MIP_MSIP
 462              	    beqz a2, .LwaitOtherHart
 463              	    /* Disable and clear all interrupts- should be only a sw interrupt */
 464              	    li a2,  MSTATUS_MIE
 465              	    csrc mstatus, a2        # clear interrupt enable bit
 466              	    csrw mie, zero
 467              	    csrw mip, zero
 468              	    # set marker as to where we are
 469              	    li a1, HLS_OTHER_HART_PASSED_WFI
 470              	    sw a1, 0(tp)
 471              	    # pass HLS address
 472              	    mv  a0, tp
 473              	    j main_other_hart
 474              	.LoopForeverOther:
 475              	    #in case of return, loop forever. nop's added so can be seen in debugger
 476              	    nop
 477              	    nop
 478              	    j .LoopForeverOther
