 228              	#ifdef __GNUC__
 229              	
 230              	#define read_reg(reg) ({ unsigned long __tmp; \
 231              	  asm volatile ("mv %0, " #reg : "=r"(__tmp)); \
 232              	  __tmp; })
 233              	
 234              	#define read_csr(reg) __extension__({ unsigned long __tmp; \
 235              	  asm volatile ("csrr %0, " #reg : "=r"(__tmp)); \
 236              	  __tmp; })
 237              	
 238              	#define write_csr(reg, val) __extension__({ \
 239              	  asm volatile ("csrw " #reg ", %0" :: "rK"(val)); })
 240              	
 241              	#define swap_csr(reg, val) ({ unsigned long __tmp; \
 242              	  asm volatile ("csrrw %0, " #reg ", %1" : "=r"(__tmp) : "rK"(val)); \
 243              	  __tmp; })
 244              	
 245              	#define set_csr(reg, bit) __extension__({ unsigned long __tmp; \
 246              	  asm volatile ("csrrs %0, " #reg ", %1" : "=r"(__tmp) : "rK"(bit)); \
 247              	  __tmp; })
 248              	
 249              	#define clear_csr(reg, bit) __extension__({ unsigned long __tmp; \
 250              	  asm volatile ("csrrc %0, " #reg ", %1" : "=r"(__tmp) : "rK"(bit)); \
 251              	  __tmp; })
 252              	
