 176:../src/platform/mpfs_hal/common/nwc/mss_io.c **** /***************************************************************************//**
 177:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *    MSSIO OFF Mode
 178:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *
 179:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *    The following settings are applied if MMSIO unused/off
 180:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *
 181:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *      The IO Buffers are disabled.
 182:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *      Output drivers are disabled (set the drv<3:0> bits to 0000, output
 183:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *      enable "mss_oe" bit to 0)
 184:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *      Disable the WPU bit set to 0 and enable the WPD bit set to 1.
 185:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *      Receivers are disabled. (Ibufmd<2:0> set to 7)
 186:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *
 187:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *      MSS can enable OFF mode through configurator bit for selective MSSIO
 188:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *      from Bank2/Bank4 by making drv<3:0>/mss_oe bit to "0" for that
 189:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *      particular MSSIO making Output driver disabled and ibufmd <2:0>  bit to
 190:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *      "7" for that particular MSSIO making input receiver disabled.
 191:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *
 192:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  */
 193:../src/platform/mpfs_hal/common/nwc/mss_io.c **** 
 194:../src/platform/mpfs_hal/common/nwc/mss_io.c **** /***************************************************************************//**
 195:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  * mssio_setup()
 196:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *
 197:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  * Setup the IOMUX and IO bank 2 and 4.
 198:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *
 199:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  * To setup bank 2 and 4, ncode and pcode scb registers in system
 200:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  * register block are set as per Libero supplied values.
 201:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  * These need to be transferred to I/0
