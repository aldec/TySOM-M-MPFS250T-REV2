 293:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** (
 294:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     mss_uart_instance_t * this_uart,
 295:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     const uint8_t * p_sz_string
 296:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** )
 297:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** {
 298:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     uint32_t char_idx = 0u;
 299:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     uint32_t fill_size;
 300:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     uint8_t data_byte;
 301:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     uint8_t status;
 302:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
 303:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     ASSERT(p_sz_string != ((uint8_t*)0));
 304:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
 305:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     if (p_sz_string != ((uint8_t*)0))
 306:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     {
 307:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****         /* Get the first data byte from the input buffer */
 308:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****         data_byte = p_sz_string[char_idx];
 309:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
 310:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****         /* First check for the NULL terminator byte.
 311:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****          * Then remain in this loop until the entire string in the input buffer
 312:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****          * has been transferred to the UART.
 313:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****          */
 314:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****         while (0u != data_byte)
 315:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****         {
 316:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             /* Wait until TX FIFO is empty. */
 317:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             do
 318:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             {
 319:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 status = this_uart->hw_reg->LSR;
 320:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 this_uart->status |= status;
 321:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             }while (0u == (status & MSS_UART_THRE));
 322:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
 323:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             /* Send bytes from the input buffer until the TX FIFO is full
 324:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****              * or we reach the NULL terminator byte.
 325:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****              */
 326:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             fill_size = 0u;
 327:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
 328:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             while ((0u != data_byte) && (fill_size < TX_FIFO_SIZE))
 329:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             {
 330:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 /* Send the data byte */
 331:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 this_uart->hw_reg->THR = data_byte;
 332:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 ++fill_size;
 333:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 char_idx++;
 334:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 /* Get the next data byte from the input buffer */
 335:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 data_byte = p_sz_string[char_idx];
 336:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             }
 337:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****         }
 338:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     }
 339:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** }
