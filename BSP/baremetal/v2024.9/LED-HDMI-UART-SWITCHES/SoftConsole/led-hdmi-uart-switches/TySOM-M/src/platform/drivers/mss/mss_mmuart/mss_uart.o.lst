 582:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             case MSS_UART_INVALID_LOOPBACK:
 583:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 /* Fall through to default. */
 584:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             default:
