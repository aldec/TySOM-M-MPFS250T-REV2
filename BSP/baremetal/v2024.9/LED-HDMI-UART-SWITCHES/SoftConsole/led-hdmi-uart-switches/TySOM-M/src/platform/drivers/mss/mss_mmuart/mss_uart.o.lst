 873:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     const mss_uart_instance_t * this_uart
 874:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** )
 875:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** {
 876:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     uint8_t status = MSS_UART_INVALID_PARAM;
 877:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
 878:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     /*
 879:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****      * Extract UART modem status and place in lower bits of "status".
 880:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****      * Bit 0 - Delta Clear to Send Indicator
 881:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****      * Bit 1 - Delta Clear to Receive Indicator
 882:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****      * Bit 2 - Trailing edge of Ring Indicator detector
 883:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****      * Bit 3 - Delta Data Carrier Detect indicator
 884:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****      * Bit 4 - Clear To Send
 885:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****      * Bit 5 - Data Set Ready
 886:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****      * Bit 6 - Ring Indicator
 887:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****      * Bit 7 - Data Carrier Detect
 888:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****      */
 889:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     status = this_uart->hw_reg->MSR;
 890:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
 891:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     return status;
 892:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** }
