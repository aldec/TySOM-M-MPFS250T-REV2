 556:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             case MSS_UART_LOCAL_LOOPBACK_OFF:
 557:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 /* Disable local loopback */
