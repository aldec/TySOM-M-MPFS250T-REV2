 236:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** MSS_UART_polled_tx
 237:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** (
 238:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     mss_uart_instance_t * this_uart,
 239:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     const uint8_t * pbuff,
 240:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     uint32_t tx_size
 241:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** )
 242:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** {
 243:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     uint32_t char_idx = 0u;
 244:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     uint32_t size_sent;
 245:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     uint8_t status;
 246:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     uint32_t temp_tx_size = tx_size;
 247:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
 248:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     ASSERT(pbuff != ( (uint8_t*)0));
 249:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     ASSERT(tx_size > 0u);
 250:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
 251:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     if ((pbuff != ((uint8_t*)0)) && (temp_tx_size > 0u))
 252:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     {
 253:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****         /* Remain in this loop until the entire input buffer
 254:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****          * has been transferred to the UART.
 255:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****          */
 256:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****         do
 257:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****         {
 258:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             /* Read the Line Status Register and update the sticky record */
 259:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             status = this_uart->hw_reg->LSR;
 260:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             this_uart->status |= status;
 261:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
 262:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             /* Check if TX FIFO is empty. */
 263:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             if (status & MSS_UART_THRE)
 264:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             {
 265:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 uint32_t fill_size = TX_FIFO_SIZE;
 266:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
 267:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 /* Calculate the number of bytes to transmit. */
 268:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 if (temp_tx_size < TX_FIFO_SIZE)
 269:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 {
 270:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                     fill_size = temp_tx_size;
 271:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 }
 272:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
 273:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 /* Fill the TX FIFO with the calculated the number of bytes. */
 274:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 for (size_sent = 0u; size_sent < fill_size; ++size_sent)
 275:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 {
 276:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                     /* Send next character in the buffer. */
 277:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                     this_uart->hw_reg->THR = pbuff[char_idx];
 278:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                     char_idx++;
 279:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 }
 280:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
 281:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 /* find the number of bytes remaining(not transmitted yet) */
 282:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 temp_tx_size -= size_sent;
 283:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             }
 284:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****         }while (temp_tx_size);
 285:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     }
 286:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** }
