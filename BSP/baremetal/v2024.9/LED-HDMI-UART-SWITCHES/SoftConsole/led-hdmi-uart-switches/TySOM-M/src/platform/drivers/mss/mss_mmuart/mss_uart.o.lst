  43:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** /* This variable tracks if the UART peripheral is located on S5 or S6 on AXI
  44:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****  * switch. This will be used to determine which UART instance to be passed to
  45:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****  * UART interrupt handler. value 0 = S5(low). value 1 = S6(high)
  46:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****  * Bit positions:
  47:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****  * 0 ==> MMUART0
  48:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****  * 1 ==> MMUART1
  49:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****  * 2 ==> MMUART2
  50:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****  * 3 ==> MMUART3
  51:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****  * 4 ==> MMUART4
  52:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
  53:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****  */
  54:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** static uint32_t g_uart_axi_pos = 0x0u;
