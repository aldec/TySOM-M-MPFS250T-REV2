 850:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
 851:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     /*
 852:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****      * Extract UART receive error status.
 853:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****      * Bit 1 - Overflow error status
 854:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****      * Bit 2 - Parity error status
 855:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****      * Bit 3 - Frame error status
 856:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****      * Bit 4 - Break interrupt indicator
 857:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****      * Bit 7 - FIFO data error status
 858:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****      */
 859:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     this_uart->status |= (this_uart->hw_reg->LSR);
 860:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     status = (this_uart->status & STATUS_ERROR_MASK);
 861:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     /* Clear the sticky status after reading */
 862:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     this_uart->status = 0u;
 863:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
 864:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     return status;
 865:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** }
