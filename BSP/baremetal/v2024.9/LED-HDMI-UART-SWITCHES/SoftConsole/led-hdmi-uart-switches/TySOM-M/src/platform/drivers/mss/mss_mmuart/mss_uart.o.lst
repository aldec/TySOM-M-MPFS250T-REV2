 896:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****  * See mss_uart.h for details of how to use this function.
 897:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****  */
 898:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** uint8_t
 899:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** MSS_UART_get_tx_status
 900:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** (
 901:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     mss_uart_instance_t * this_uart
 902:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** )
 903:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** {
 904:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     uint8_t status = MSS_UART_TX_BUSY;
 905:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
 906:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     /* Read the Line Status Register and update the sticky record. */
 907:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     status = this_uart->hw_reg->LSR;
 908:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     this_uart->status |= status;
 909:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     
 910:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     /*
 911:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****      * Extract the transmit status bits from the UART's Line Status Register.
 912:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****      * Bit 5 - Transmitter Holding Register/FIFO Empty (THRE) status. 
 913:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                (If = 1, TX FIFO is empty)
 914:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****      * Bit 6 - Transmitter Empty (TEMT) status. 
 915:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                (If = 1, both TX FIFO and shift register are empty)
 916:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****      */
 917:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     status &= (MSS_UART_THRE | MSS_UART_TEMT);
 918:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
 919:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     return status;
 920:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** }
