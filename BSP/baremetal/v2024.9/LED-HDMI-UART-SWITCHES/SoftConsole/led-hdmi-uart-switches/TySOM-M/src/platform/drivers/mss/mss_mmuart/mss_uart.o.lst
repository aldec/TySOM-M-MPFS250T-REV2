 822:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
 823:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             if (tx_size < TX_FIFO_SIZE)
 824:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             {
 825:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 fill_size = tx_size;
 826:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             }
 827:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
 828:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             /* Fill up FIFO */
 829:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             for (size_sent = 0u; size_sent < fill_size; size_sent++)
