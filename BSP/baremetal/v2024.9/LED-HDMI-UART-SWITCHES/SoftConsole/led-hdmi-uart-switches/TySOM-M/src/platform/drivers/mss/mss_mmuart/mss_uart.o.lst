 209:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     uint8_t line_config
 210:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** )
 211:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** {
 212:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     /* Perform generic initialization */
 213:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     global_init(this_uart, baud_rate, line_config);
 214:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     
 215:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     /* Disable LIN mode */
 216:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     this_uart->hw_reg->MM0 &= ~ELIN_MASK;
 217:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
 218:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     /* Disable IrDA mode */
 219:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     this_uart->hw_reg->MM1 &= ~EIRD_MASK;
 220:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
 221:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     /* Enable SmartCard Mode : Only when data is 8-bit and 2 stop bits */
 222:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     if ((MSS_UART_DATA_8_BITS | MSS_UART_TWO_STOP_BITS) ==
 223:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****         (line_config & (MSS_UART_DATA_8_BITS | MSS_UART_TWO_STOP_BITS)))
 224:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     {
 225:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****         this_uart->hw_reg->MM2 |= EERR_MASK;
 226:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
 227:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****         /* Enable single wire half-duplex mode */
 228:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****         this_uart->hw_reg->MM2 |= ESWM_MASK;
 229:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     }
 230:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** }
