 564:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             break;
 565:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             
 566:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             case MSS_UART_REMOTE_LOOPBACK_OFF:
 567:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             case MSS_UART_AUTO_ECHO_OFF:
 568:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 /* Disable remote loopback & automatic echo */
 569:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 this_uart->hw_reg->MCR &= ~(RLOOP_MASK|ECHO_MASK);
 570:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             break;
 571:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             
