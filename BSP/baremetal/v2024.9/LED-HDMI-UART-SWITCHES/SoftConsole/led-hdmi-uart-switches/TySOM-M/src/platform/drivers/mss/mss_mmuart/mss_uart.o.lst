 360:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****         this_uart->tx_buff_size = tx_size;
 361:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****         this_uart->tx_idx = 0u;
 362:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
 363:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****         /* assign default handler for data transfer */
 364:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****         this_uart->tx_handler = default_tx_handler;
 365:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
 366:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****         /* enables TX interrupt */
 367:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****         this_uart->hw_reg->IER |= ETBEI_MASK;
 368:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****         enable_irq(this_uart);
 369:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     }
 370:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** }
