 811:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
 812:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     /* Fill the UART's Tx FIFO until the FIFO is full or the complete input
 813:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****      * buffer has been written. */
 814:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     if ((tx_buffer != ((uint8_t*)0)) && (tx_size > 0u))
 815:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****     {
 816:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****         status = this_uart->hw_reg->LSR;
 817:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****         this_uart->status |= status;
 818:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
 819:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****         if (status & MSS_UART_THRE)
 820:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****         {
