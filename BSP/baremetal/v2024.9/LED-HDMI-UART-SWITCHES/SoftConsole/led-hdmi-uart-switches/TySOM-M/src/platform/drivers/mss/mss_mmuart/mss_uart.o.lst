 575:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 break;
 576:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 
 577:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             case MSS_UART_AUTO_ECHO_ON:
 578:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 /* Enable automatic echo */
 579:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****                 this_uart->hw_reg->MCR |= (1u << ECHO);
 580:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****             break;
